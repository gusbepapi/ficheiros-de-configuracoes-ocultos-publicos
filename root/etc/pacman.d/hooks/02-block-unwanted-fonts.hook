[Trigger]
Operation = Install
Type = Package
Target = cantarell-fonts
Target = noto-fonts
Target = noto-fonts-emoji
Target = noto-fonts-extra
Target = tex-gyre-fonts
Target = ttf-dejavu
Target = ttf-liberation
Target = ttf-roboto

[Action]
Description = Checking for unwanted font packages...
When = PreTransaction
Exec = /usr/local/bin/block-fonts
