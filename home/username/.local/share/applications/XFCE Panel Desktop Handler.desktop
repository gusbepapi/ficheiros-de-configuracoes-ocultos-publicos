[Desktop Entry]
Categories = Settings; X-XFCE-SettingsDialog; X-XFCE-SettingsDialog-Panel; X-XFCE-SettingsDialog-Panel-Item; X-XFCE-SettingsDialog-Panel-Item-Launcher; XFCE;
Comment[ca] = Afegeix un nou llançador al tauler a partir de la informació d'aquest fitxer d'escriptori
Comment[de] = Einen neuen Starter zur Leiste hinzufügen, basierend auf den Informationen in dieser Schreibtischdatei
Comment[el] = Δημιουργία νέου εκκινητή στο ταμπλό από αυτό το αρχείο .desktop
Comment[es] = Agregar un lanzador nuevo al panel basándose en la información de este fichero .desktop
Comment[fr] = Ajouter un nouveau lanceur dans le tableau de bord avec les informations de ce fichier desktop
Comment[it] = Aggiunge un nuovo avviatore sul pannello sulla base delle informazioni contenute in questo file desktop
Comment[ja] = このデスクトップファイルの情報を基にパネルに新しいランチャーを追加します。
Comment[ka] = სამუშაო მაგიდის ამ ფაილის ინფორმაციაზე დაყრდნობით, პანელზე ახალი გამშვების დამატება
Comment[nl] = Voeg een nieuwe starter toe aan de werkbalk, gebaseerd op de informatie van dit bureaubladbestand
Comment[pt_BR] = Adicionar um novo lançador ao painel baseado na informação deste arquivo de área de trabalho
Comment[pt] = Adicionar um novo lançador ao painel com base nas informações deste ficheiro desktop
Comment[ro] = Adăugați un nou lansator în panou utilizând informațiile din acest fișier desktop
Comment[uk] = Додати новий запускач до панелі на основі інформації з його desktop файлу
Comment = Add a new launcher to the panel based on the information of this desktop file
Exec = xfce4-panel --add = launcher %u
Icon = application-x-executable
MimeType = application/x-desktop; 
Name[ca] = Crea un llançador al tauler
Name[de] = Starter zur Leiste hinzufügen
Name[el] = Δημιουργία Εκκινητή στο ταμπλό
Name[es] = Crear un lanzador en el panel
Name[fr] = Créer un lanceur sur le tableau de bord
Name[it] = Crea un avviatore sul pannello
Name[ja] = Xfce パネルにランチャーを作成
Name[ka] = პანელზე გამშვების შექმნა
Name[nl] = Maak starter op de werkbalk
Name[pt] = Criar lançador no painel
Name[ro] = Creați un lansator în panou
Name[uk] = Створити запускач на панелі
Name = Create Launcher on the panel
NoDisplay = true
StartupNotify = false
Terminal = false
Type = Application
Version = 1.1
X-XFCE-Source = xfce4-panel