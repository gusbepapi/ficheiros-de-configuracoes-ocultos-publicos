[Desktop Entry]
Categories = GNOME; GTK; Security; Settings; X-GNOME-Settings-Panel; X-GNOME-SystemSettings; X-Unity-Settings-Panel; X-XFCE-SettingsDialog; X-XFCE-SystemSettings;
Comment = Change all hardcoded icons
Comment[ca] = Canvia totes les icones incrustades
Comment[de] = Ändert alle eingebetteten Icons
Comment[el] = Αλλάζει όλα τα ενσωματωμένα εικονίδια
Comment[es] = Cambia todos los iconos incrustados
Comment[fr] = Change tous les icônes incrustés
Comment[it] = Cambia tutti gli iconi incollati
Comment[ja] = 全ての埋め込みアイコンを変更します
Comment[ka] = ყველა ჩამატებული ხატულას შეცვლა
Comment[nl] = Verander alle ingebedde pictogrammen
Comment[pt] = Altera todos os ícones embutidos
Comment[ro] = Schimbă toate pictogramele încorporate
Comment[uk] = Змінити всі вбудовані значки
Exec = bash -c 'zenity --info --title = "Fixing all hardcoded path icons" --text = "An empty window means that all icons were already fixed.\n$(pkexec hardcode-fixer)" --width = 500 --height = 300' 
# GenericName =
Keywords = hardcode; hardcoded; icon; icons;
