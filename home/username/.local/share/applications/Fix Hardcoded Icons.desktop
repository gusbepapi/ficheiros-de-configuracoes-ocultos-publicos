Keywords[es] = incrustado; icon; icons; icono; iconos;
Keywords[fr] = incrusté; icon; icons; icône; icônes;
Keywords[it] = incollato; icon; icons; icona; icone;
Keywords[ja] = アイコン; 埋め込み;
