Keywords[es] = letra; tipo; tipografía;
Keywords[fr] = fontes; polices;
Keywords[it] = carattere; carattere tipografico; caratteri; caratteri tipografici; tipi di carattere; tipo di carattere;
Keywords[ja] = fonts; fontface; フォント書体; 
Keywords[ka] = fonts; fontface; ფონტი; 
