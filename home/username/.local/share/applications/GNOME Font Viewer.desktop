[Desktop Entry]
Categories = GTK; GNOME; Utility; X-GNOME-Utilities; 
Comment = View fonts on your system
Comment[ca] = Visualitzeu tots els tipus de lletra del sistema
Comment[de] = Schriftarten Ihres Systems betrachten
Comment[el] = Δείτε τις γραμματοσειρές του συστήματος σας
Comment[en_GB] = View fonts on your system
Comment[es] = Ver las tipografías de su sistema
Comment[fr] = Affiche les polices de votre système
Comment[it] = Visualizza i tipi di carattere presenti nel sistema
Comment[ja] = システム上のフォントを閲覧します
Comment[ka] = თქვენს სისტემაში არსებული ფონტების ნახვა
Comment[nl] = Lettertypen op uw systeem bekijken
Comment[pt_BR] = Veja fontes no seu sistema
Comment[pt] = Ver as fontes existentes no sistema
Comment[ro] = Vizualizați fonturile instalate pe sistemul dumneavoastră
Comment[uk] = Переглянути шрифти на вашій системі
DBusActivatable = true
Exec = gnome-font-viewer %u
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon = org.gnome.font-viewer
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords = font; fontbook; fonts; fontface;  
Keywords[ca] = tipografia; tipus de lletra;
Keywords[de] = Schriftart; Schriftschnitt; 
