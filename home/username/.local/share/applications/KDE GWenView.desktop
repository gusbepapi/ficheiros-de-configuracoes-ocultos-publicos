[Desktop Entry]
Categories = Graphics; KDE; Photography; Qt; Viewer;
Comment = A simple image viewer
Comment[ca] = Un visualitzador d'imatges senzill
Comment[ca@valencia] = Un visor d'imatges senzill
Comment[de] = Ein einfacher Bildbetrachter
Comment[el] = Ένας απλός προβολέας εικόνων
Comment[en_GB] = A simple image viewer
Comment[es] = Un visor de imágenes sencillo
Comment[fr] = Un afficheur simple d'images
Comment[it] = Un semplice visore di immagini
Comment[ja] = シンプルな画像ビューア
Comment[ka] = სურათების დასათვალიერებელი მარტივი პროგრამა
Comment[nl] = Een eenvoudige afbeeldingenviewerów
Comment[pt_BR] = Um visualizador simples de imagens
Comment[pt] = Um visualizador de imagens simples
Comment[ro] = Un vizualizator de imagini simplu
Comment[uk] = Простий переглядач зображень
Exec = gwenview %U
GenericName = KDE Image Viewer
GenericName[ca] = Visualitzador d'imatges del KDE
GenericName[ca@valencia] = Visor d'imatges de KDE
GenericName[de] = KDE-Bildbetrachter
GenericName[el] = Προβολέας εικόνων του KDE
GenericName[en_GB] = KDE Image Viewer
GenericName[es] = Visor de imágenes de KDE
GenericName[fr] = Afficheur d'images de KDE
GenericName[it] = Visore di immagini di KDE
GenericName[ja] = KDE 画像ビューア
GenericName[ka] = სურათები დასათვალიერებელი პროგრამა KDE-სთვის
GenericName[nl] = KDE afbeeldingenviewer
GenericName[pt_BR] = Visualizador de imagens da KDE
GenericName[pt] = Visualizador de Imagens do KDE
GenericName[ro] = Vizualizor de imagini pentru KDE
GenericName[uk] = Переглядач зображень KDE
Icon = gwenview
# InitialPreference should be greater than Okular so that Gwenview is the primary application associated with images, but less than Konqueror or Dolphin so that Gwenview is not the primary applications for folders.
InitialPreference = 8
MimeType =  application/x-krita; image/avif; image/bmp; image/gif; image/heif; image/jpeg; image/jxl; image/png; image/tiff; image/webp; image/x-adobe-dng; image/x-canon-cr2; image/x-canon-crw; image/x-eps; image/x-fuji-raf; image/x-icns; image/x-ico; image/x-kde-raw; image/x-kodak-dcr; image/x-kodak-k25; image/x-kodak-kdc; image/x-minolta-mrw; image/x-nikon-nef; image/x-olympus-orf; image/x-panasonic-rw; image/x-panasonic-rw2; image/x-pentax-pef; image/x-portable-bitmap; image/x-portable-graymap; image/x-portable-pixmap; image/x-psd; image/x-sigma-x3f; image/x-sony-arw; image/x-sony-sr2; image/x-sony-srf; image/x-tga; image/x-webp; image/x-xbitmap; image/x-xcf; image/x-xpixmap; inode/directory;
Name = GWenView
Terminal = false
Type = Application
X-DBUS-ServiceName = org.kde.gwenview
X-DocPath = gwenview/index.html
