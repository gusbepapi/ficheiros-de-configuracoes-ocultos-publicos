[Desktop Entry]
Categories =  Archiving; Compression; KDE; Qt; Utility; X-KDE-Utilities-File;
Comment = Work with file archives
Comment[ca] = Treball amb arxius de fitxer
Comment[de] = Arbeiten mit Dateiarchiven
Comment[el] = Εργασία με αρχειοθήκες
Comment[en_GB] = Work with file archives
Comment[es] = Trabajar con archivos comprimidos
Comment[fr] = Travailler avec des archives de fichiers
Comment[it] = Lavora con gli archivi di file
Comment[ja] = ファイルアーカイブを操作
Comment[ka] = იმუშავეთ ფაილის არქივებთან
Comment[nl] = Mert bestandsarchieven werken
Comment[pt_BR] = Manipulação de arquivos compactados
Comment[pt] = Lidar com pacotes em ficheiros
Comment[ro] = Lucrează cu arhive de fișiere
Comment[ru] = Работа с архивами файлов
Comment[uk] = Робота з файловими архівами
Exec = ark %U
GenericName = Archiving Tool
GenericName[ca] = Eina d'arxivament
GenericName[de] = Archivprogramm
GenericName[el] = Εργαλείο αρχειοθέτησης
GenericName[en_GB] = Archiving Tool
GenericName[es] = Archivador
GenericName[fr] = Outil d'archivage
GenericName[it] = Strumento di archiviazione
GenericName[ja] = アーカイブツール
GenericName[ka] = არქივატორი
GenericName[nl] = Archiefgereedschap
GenericName[pt_BR] = Ferramenta de Arquivamento
GenericName[pt] = Ferramenta de Armazenamento
GenericName[ro] = Utilitar de arhivare
GenericName[uk] = Засіб роботи з архівами
Icon = ark
InitialPreference = 3
MimeType =  application/gzip; application/vnd.debian.binary-package; application/vnd.ms-cab-compressed; application/vnd.rar; application/x-7z-compressed; application/x-archive; application/x-bcpio; application/x-bzip-compressed-tar; application/x-bzip; application/x-cd-image; application/x-compress; application/x-compressed-tar; application/x-cpio-compressed; application/x-cpio; application/x-deb; application/x-iso9660-appimage; application/x-java-archive; application/x-lha; application/x-lrzip-compressed-tar; application/x-lz4-compressed-tar; application/x-lzip-compressed-tar; application/x-lzma-compressed-tar; application/x-lzma; application/x-rar; application/x-rpm; application/x-source-rpm; application/x-sv4cpio; application/x-sv4crc; application/x-tar; application/x-tarz; application/x-tzo; application/x-xar; application/x-xz-compressed-tar; application/x-xz; application/x-zstd-compressed-tar; application/zip; application/zstd;
Name = Ark
StartupWMClass = ark
Terminal = false
Type = Application
X-DBUS-ServiceName = org.kde.ark
X-DBUS-StartupType = Multi
X-DocPath = ark/index.html
