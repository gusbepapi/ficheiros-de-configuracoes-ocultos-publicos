StartupNotify = false
StartupWMClass = vscodium - insiders
# StartupWMClass = codium-insiders
Terminal = false
TryExec = sh
Type = Application
Version = 1.0

[Desktop Action new-empty-window]
Exec = codium-insiders --new-window
Icon = vscodium-insiders
