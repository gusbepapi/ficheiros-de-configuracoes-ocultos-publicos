[Desktop Entry]
Categories = Debugger; Development; Git; IDE; Programming; TextEditor;
Comment = Editor for building and debugging modern web and cloud applications
Exec = code-insiders %f
Comment[ca] = Editor per crear i depurar aplicacions web i de núvols modernes
Comment[de] = Editor zum Erstellen und Debuggen moderner Web- und Cloud-App
Comment[es] = Editor para la construcción y depuración de aplicaciones web y de nube modernas.
Comment[fr] = Editeur pour la création et le débogage d’applications Web et cloud modernes
Comment[it] = Editor per la creazione e il debug di moderne applicazioni Web e cloud
Comment[ja] = 現代的なWebアプリケーションとクラウドアプリケーションの作成とデバッグのためのエディター
Comment[ka] = მოდერნიული ვებ და ქლაუდ აპლიკაციების შექმნის და დებაგინგის მხარე
Comment[nl] = Editor voor het bouwen en debuggen van moderne web- en cloud-applicaties
Comment[pt_BR] = Editor para criação e depuração de aplicativos modernos da Web e de nuvem
Comment[pt] = Editor para criação e depuração de aplicações modernas da Web e de nuvem
Comment[ro] = Editor pentru construirea și depanarea aplicațiilor moderne web și cloud
Comment[uk] = Редактор для створення та налагодження сучасних веб-додатків
GenericName = IDE
Icon = visual-studio-code-insiders
Keywords = editor; IDE; plaintext; text; write;
Keywords[ca] = editor; escriure; IDE; text; text simple;
Keywords[de] = editor; IDE; klartext; schreiben; text;
Keywords[el] = editor; IDE; plaintext; text; write; γράψιμο; εγγραφή; επεξεργαστής; κείμενο;
Keywords[es] = editor; escribir; IDE; plano; texto;
Keywords[fr] = écrire; éditeur; IDE; texte brut;
Keywords[it] = editor; IDE; scrivere; testo; text;
Keywords[ja] = editor; IDE; plaintext; text; write; エディター; テキスト; プレーンテキスト;
Keywords[ka] = editor; IDE; plaintext; text; write; ედიტორი; ტექსტი; ტექსტური ფაილი; ტექსტური ფაილის რედაქტორი; წერა;
Keywords[nl] = editor; IDE; plaintext; platte tekst; schrijven; tekst; teksteditor; tekstverwerker; text; write;
Keywords[pt_BR] = editor; escrever; IDE; texto; texto plano; texto puro; texto sem formatação; texto simples;
Keywords[pt] = editor; escrever; IDE; simples; texto;
Keywords[ro] = editor; IDE; plaintext; scrie; text; write;
Keywords[uk] = IDE; запис; редактор; текст;
MimeType = application/x-shellscript; inode/directory; text/english; text/plain; text/x-c; text/x-c++; text/x-c++hdr; text/x-c++src; text/x-chdr; text/x-csrc; text/x-java; text/x-makefile; text/x-moc; text/x-pascal; text/x-tcl; text/x-tex;
Name = VSCode Insiders
StartupNotify = true
StartupWMClass = Code - Insiders
Terminal = false
Type = Application
Version = 1.1

[Desktop Action new-empty-window]
Name = New Empty Window
Name[ca] = Finestra nova buida
Name[de] = Neues leeres Fenster
Name[el] = Νέο κενό παράθυρο
Name[es] = Nueva ventana vacía
Name[fr] = Nouvelle fenêtre vide
Name[it] = Nuova finestra vuota
Name[ja] = 新しい空のウィンドウ
Name[ka] = ახალი ცარიელი ფანჯარა
Name[nl] = Nieuw leeg venster
Name[pt_BR] = Nova janela vazia
Name[pt] = Nova janela vazia
Name[ro] = Fereastră nouă goală
Name[uk] = Нове порожнє вікно
Exec = code-insiders --new-window %F
Icon = com.visualstudio.code.insiders
