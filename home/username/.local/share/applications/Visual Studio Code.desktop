[Desktop Entry]
Actions = new-empty-window;
Categories = Development; IDE; TextEditor;
Comment = Code Editing. Redefined.
Comment[ca] = Editor de codi redefinit.
Comment[de] = Code-Editor. Neu definiert.
Comment[el] = Επεξεργαστής κώδικα. Επαναπροσδιορισμένος.
Comment[es] = Editor de código redefinido.
Comment[en_GB] = Redefined code editor.
Comment[fr] = Éditeur de code. Redéfini.
Comment[it] = Editor di codice. Ridesignato.
Comment[ja] = コードエディター。再定義されました。
Comment[ka] = კოდის რედაქტორი. განახლებულია.
Comment[nl] = Code-editor. Herdefinieerd.
Comment[pt] = Editor de código-fonte sofisticado.
Comment[ro] = Editor de cod. Redefinit.
Comment[uk] = Редагування коду. Переосмислено.
Exec = $HOME/.local/bin/code --unity-launch %F
GenericName = Text Editor
GenericName[ca] = Editor de text
GenericName[de] = Texteditor
GenericName[el] = Επεξεργαστής κειμένου
GenericName[es] = Editor de texto
GenericName[fr] = Éditeur de texte
GenericName[it] = Editor di testo
GenericName[ja] = テキストエディター
GenericName[ka] = ტექსტის რედაქტორი
GenericName[nl] = Teksteditor
GenericName[pt] = Editor de texto
GenericName[ro] = Editor de text
GenericName[uk] = Редактор тексту
Icon = visual-studio-code
Keywords = code; visual studio code; visual-studio-code; vscode;
MimeType = application/x-code-workspace; inode/directory; text/plain;
Name = Visual Studio Code
StartupNotify = false
StartupWMClass = code
Terminal = false
Type = Application
Version = 1.1

[Desktop Action new-empty-window]
Exec = $HOME/.local/bin/code --new-window %F
Icon = visual-studio-code
Name = New Empty Window
