Keywords[fr] = cmd; command; commands; commande; commandes; commandline; ligne de commande; prompt; shell; terminal;
Keywords[it] = cmd; comando; comando; di linea prompt; shell; terminale; terminal;
Keywords[ja] = cmd; command; commandline; commands; prompt; shell; コマンド; コマンドライン; シェル; ターミナル; プロンプト;
Keywords[ka] = cmd; command; commandline; commands; prompt; shell; terminal; ბრძანების ხაზი; სწრაფი; ტერმინალი; ჭურვი;
Keywords[nl] = cmd; command; commands; commandline; opdracht; opdrachtprompt; opdrachtregel; opdrachtregels; prompt; shell; terminal; terminalvenster;
