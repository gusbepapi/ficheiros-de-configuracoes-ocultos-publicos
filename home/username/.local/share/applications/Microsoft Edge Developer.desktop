MimeType = application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/microsoft-edge;
Name = Microsoft Edge Developer
StartupNotify = true
StartupWMClass = Microsoft-edge-dev
# StartupWMClass = microsoft-edge-dev
Terminal = false
TryExec = microsoft-edge-dev
Type = Application
Version = 1.0

[Desktop Action new-private-window]
Exec = microsoft-edge-dev --inprivate
