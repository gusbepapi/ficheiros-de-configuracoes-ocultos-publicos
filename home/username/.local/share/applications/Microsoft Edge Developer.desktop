[Desktop Entry]
Actions = new-private-window;new-window;
Categories = Network;WebBrowser;
Comment = Access the Internet
Comment[ca] = Accedeix a Internet
Comment[de] = Auf das Internet zugreifen
Comment[el] = Πρόσβαση στο Διαδίκτυο
Comment[en_GB] = Access the Internet
Comment[es] = Acceder a Internet
Comment[fr] = Accéder à Internet
Comment[gl] = Acceder a Internet
Comment[it] = Accedere a Internet
Comment[ja] = インターネットにアクセスします
Comment[ka] = ინტერნეტზე წვდომა
Comment[mi] = Uru ki te Ipurangi
Comment[nl] = Toegang tot internet
Comment[pt] = Aceder à Internet
Comment[pt_BR] = Acessar a Internet
Comment[pt_PT] = Aceder à Internet
Comment[ro] = Accesați Internetul
Comment[sc] = Atzèdi a Internet
Comment[scn] = Accediri a Internet
Comment[uk] = Доступ до Інтернету
Exec = microsoft-edge-dev %U
GenericName = Web Browser
GenericName[ca] = Navegador web
GenericName[de] = Webbrowser
GenericName[el] = Πρόγραμμα περιήγησης ιστού
GenericName[en_GB] = Web Browser
GenericName[es] = Navegador web
GenericName[fr] = Navigateur web
GenericName[gl] = Navegador web
GenericName[it] = Browser web
GenericName[ja] = ウェブブラウザー
GenericName[ka] = ვებ-ბრაუზერი
GenericName[mi] = Pūtirotiro Tukutuku
GenericName[nl] = Webbrowser
GenericName[pt] = Navegador web
GenericName[pt_BR] = Navegador web
GenericName[pt_PT] = Navegador web
GenericName[ro] = Browser web
GenericName[sc] = Navigadore web
GenericName[scn] = Navigaturi web
GenericName[uk] = Вебпереглядач
Icon = microsoft-edge-dev
Keywords = browser; dev; developer; edge; internet; microsoft; web; 
Keywords[ca] = dev; developer; edge; internet; microsoft; navegador; web; 
Keywords[de] = Browser; dev; developer; edge; Internet; microsoft; Web; 
Keywords[el] = dev; developer; edge; microsoft; διαδίκτυο; ιστού; πρόγραμμα περιήγησης; 
Keywords[en_GB] = browser; dev; developer; edge; internet; microsoft; web; 
Keywords[es] = dev; developer; edge; internet; microsoft; navegador; web; 
