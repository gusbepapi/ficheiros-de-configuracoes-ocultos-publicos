Keywords[ja] = dev; developer; edge; microsoft; インターネット; ウェブ; ブラウザー; 
Keywords[ka] = dev; developer; edge; microsoft; ბრაუზერი; ვებ; ინტერნეტი; 
Keywords[mi] = dev; developer; edge; ipurangi; microsoft; pūtirotiro; tukutuku; 
Keywords[nl] = browser; dev; developer; edge; internet; microsoft; web; 
Keywords[pt] = dev; developer; edge; internet; microsoft; navegador; web; 
Keywords[pt_BR] = dev; developer; edge; internet; microsoft; navegador; web; 
