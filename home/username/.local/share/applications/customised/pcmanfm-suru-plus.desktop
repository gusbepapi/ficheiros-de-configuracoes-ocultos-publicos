[Desktop Entry]
Type=Application
Icon=system-file-manager
Name=PCManFM Suru++
Name[pt]=PCManFM Suru++
Name[pt_BR]=PCManFM Suru++
GenericName=File Manager
GenericName[pt]=Gestor de ficheiros
GenericName[pt_BR]=Gerenciador de arquivos
Comment=Open Suru++ folders with PCManFM
Comment[pt]=Abre-se automaticamente os ficheiros de Suru++ com PCManFM
Comment[pt_BR]=Abre-se automaticamente os arquivos de Suru++ com PCManFM
Categories=FileManager; FileTools; Utility;
Exec=pcmanfm $HOME/GitHub/Suru++\\ Unstable/apps/64 ~/GitHub/Suru++/apps/64/ ~/GitHub/suru-plus-categories/
StartupNotify=true
StartupWMClass=pcmanfm
Terminal=false
MimeType=inode/directory;
