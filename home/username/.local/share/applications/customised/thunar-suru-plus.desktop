[Desktop Entry]
Categories=FileManager; FileTools; Utility;
Comment=Open Suru++ folders with Thunar
Comment[pt]=Abre-se automaticamente os ficheiros de Suru++ com Thunar
Comment[pt_BR]=Abre-se automaticamente os arquivos de Suru++ com Thunar
Exec=thunar ~/GitHub/Suru++\\ Unstable/apps/64 ~/GitHub/Suru++/apps/64/ ~/GitHub/suru-plus-categories/
GenericName[en_GB]=File Manager
GenericName=File Manager
GenericName[pt]=Gestor de ficheiros
GenericName[pt_BR]=Gerenciador de arquivos
Icon=Thunar
MimeType=inode/directory;
Name[en_GB]=Thunar Suru++
Name=Thunar Suru++
Name[pt]=Thunar Suru++
Name[pt_BR]=Thunar Suru++
StartupNotify=true
StartupWMClass=thunar
Terminal=false
Type=Application
X-KDE-SubstituteUID=false
