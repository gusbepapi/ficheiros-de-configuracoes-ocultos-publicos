[Desktop Entry]
Actions = new-private-window; new-window;
Categories = Internet; Network; WebBrowser;
Comment = Surf the web
Comment[de] = Im Internet surfen
Comment[el] = Μπορείτε να περιηγηθείτε στο διαδίκτυο (Web)
Comment[es] = Navegue por la web
Comment[fr] = Naviguer sur le Web
Comment[it] = Esplora il web
Comment[ja] = ウェブを閲覧します
Comment[ka] = სერფინგის ვებ
Comment[nl] = Verken het internet
Comment[pt] = Navegue na Internet
Comment[pt_BR] = Navegue na Internet
Comment[ro] = Navigați pe Internet
Comment[uk] = Перегляд сторінок Інтернету
Exec = firefox-developer %u
GenericName = Web Browser
GenericName[ca] = Navegador web
GenericName[de] = Webbrowser
GenericName[el] = Περιηγητής διαδικτύου
GenericName[es] = Navegador web
GenericName[fr] = Navigateur Web
GenericName[it] = Browser Web
GenericName[ja] = ウェブ・ブラウザ
GenericName[ka] = ინტერნეტ-ბრაუზერი
GenericName[nl] = Webbrowser
GenericName[pt] = Navegador Web
GenericName[ro] = Navigator Internet
GenericName[uk] = Веб-браузер
Icon = firefox-developer-edition
Keywords = browser; internet; web;
Keywords[ca] = Firefox; internet; navegador; web;
Keywords[de] = Firefox; Internet; Web; Webbrowser;
Keywords[el] = Firefox; internet; web; web browser; διαδικτύου; περιηγητή;
Keywords[es] = Firefox; internet; navegador; navegador web; web;
Keywords[fr] = Firefox; internet; navigateur; navigateur web; web;
Keywords[it] = browser; browser web; Firefox; internet; web;
Keywords[ja] = Firefox; internet; web; ウェブ; ブラウザ;
Keywords[ka] = Firefox; ბრაუზერი; ინტერნეტ;
Keywords[nl] = Firefox; internet; web; webbrowser; 
Keywords[pt] = Firefox; internet; navegador; navegador web; web;
Keywords[ro] = Firefox; internet; navigator; web;
Keywords[uk] = Firefox; браузер; веб;
MimeType = application/vnd.mozilla.xul+xml; application/xhtml+xml; text/html; text/mml; text/xml; x-scheme-handler/http; x-scheme-handler/https;
Name = Firefox Developer
NoDisplay = false
StartupNotify = true
StartupWMClass = firefoxdeveloperedition
Terminal = false
Type = Application
Version = 1.1

[Desktop Action new-window]
Name = New Window
Name[ca] = Finestra nova
Name[de] = Neues Fenster
Name[el] = Νέο παράθυρο
Name[es] = Nueva ventana
Name[fr] = Nouvelle fenêtre
Name[ja] = 新しいウィンドウ
Name[ka] = ახალი ფანჯარა
Name[nl] = Nieuw venster
Name[pt] = Nova janela
Name[ro] = Fereastră nouă
Name[uk] = Нове вікно
Exec = firefox-developer --new-window %u

[Desktop Action new-private-window]
Name = New Private Window
Name[ca] = Finestra privada nova
Name[de] = Neues privates Fenster
Name[el] = Νέο παράθυρο ιδιωτικής περιήγησης
Name[es] = Nueva ventana privada
Name[fr] = Nouvelle fenêtre privée
Name[it] = Nuova finestra anonima
Name[ja] = 新しいプライベートウィンドウ
Name[ka] = ახალი პირადი ფანჯარა
Name[nl] = Nieuw privévenster
Name[pt_BR] = Nova janela privativa
Name[pt_PT] = Nova janela privada
Name[ro] = Fereastră privată nouă
Name[uk] = Приватне вікно
Exec = firefox-developer --private-window %u
