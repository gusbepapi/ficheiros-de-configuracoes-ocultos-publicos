Name = Where am I?
Name[ca] = On sóc?
Name[de] = Wo bin ich?
Name[el] = Πού είμαι τώρα;
Name[es] = ¿Dónde estoy ahora?
Name[fr] = Où suis-je maintenant?
Name[it] = Dove sono adesso?
Name[ja] = どこにいますか？
Name[ka] = სად ვარ?
Name[nl] = Waar ben ik nu?
Name[pt_BR] = Onde estou agora?
Name[pt] = Onde estou agora?
Name[ro] = Unde sunt acum?
Name[uk] = Де я зараз?
StartupNotify = false
StartupWMClass = where-am-i
Terminal = true
Type = Application
Version = 1.1
X-Geoclue-Reason = It allows your current location to be shown on terminal.
X-Geoclue-Reason[ca] = Permet que es mostri la tua ubicació actual al terminal.
X-Geoclue-Reason[de] = Damit kanst du aktueller Standort auf dem Terminal angezeigt werden.
X-Geoclue-Reason[el] = Επιτρέπει την εμφάνιση της τρέχουσας τοποθεσίας στο τερματικό.
X-Geoclue-Reason[es] = Permite que su ubicación actual se muestre en la terminal.
X-Geoclue-Reason[fr] = Il permet d’afficher votre position actuelle sur le terminal.
X-Geoclue-Reason[it] = Permette di mostrare la tua posizione corrente sul terminale.
X-Geoclue-Reason[ja] = 端末に現在の位置を表示します。
X-Geoclue-Reason[ka] = ეს ნებადართულია თქვენს მიმდინარე მდებარეობას ტერმინალში გამოჩნდეს.
X-Geoclue-Reason[nl] = Hiermee kunt u uw huidige locatie op terminal weergeven.
X-Geoclue-Reason[pt_BR] = Permite que sua localização atual seja mostrada no terminal.
X-Geoclue-Reason[pt] = Permite que tua localização actual seja exibida no terminal.
X-Geoclue-Reason[ro] = Permite afișarea locației curente în terminal.
X-Geoclue-Reason[uk] = Це дозволяє показати ваше поточне місцезнаходження на терміналі.