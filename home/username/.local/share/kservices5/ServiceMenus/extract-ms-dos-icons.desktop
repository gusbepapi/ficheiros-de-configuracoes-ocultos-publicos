# Contact: piotr4@gmail.com
# Version 1.0

[Desktop Entry]
Actions = extractIcons; rawExtractIcons; rawExtractIcon
MimeType = application/x-ms-dos-executable; 
ServiceTypes = KonqPopupMenu/Plugin
Type = Service
X-KDE-Priority = TopLevel
X-KDE-StartupNotify = false
X-KDE-Submenu = Icons

[Desktop Action extractIcons]
Exec = bash -c 'type wrestool;  if [ $? -eq 0 ];  then wrestool --type = group_icon -o . -x "%u";  else kdialog --title "Package Missing" --error "Please install icoutils from your package manager.";  fi; ';   
Icon = dialog-icon-preview
Name = Extract group icons here
Name[ca] = Extreu les icones del grup aquí
Name[de] = Gruppenicons hier extrahieren
Name[es] = Extraer iconos de grupo aquí
Name[fr] = Extraire les icônes du groupe ici
Name[it] = Estrai icone di gruppo qui
Name[ja] = グループアイコンをここに抽出
Name[ka] = აქ გამოიყენეთ ჯგუფის ხატულები
Name[nl] = Groepsiconen hier uitpakken
Name[pt] = Extrair ícones do grupo aqui
Name[ro] = Extrageți aici pictogramele grupului
Name[uk] = Витягнути ікони групи тут

