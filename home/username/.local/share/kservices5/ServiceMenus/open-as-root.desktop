[Desktop Entry]
Actions = OpenAsRootKDE5
Icon = system-file-manager
ServiceTypes = KonqPopupMenu/Plugin; inode/directory; inode/directory-locked
Type = Service

[Desktop Action OpenAsRootKDE5]
Exec = pkexec env DISPLAY = $DISPLAY XAUTHORITY = $XAUTHORITY KDE_SESSION_VERSION = 5 KDE_FULL_SESSION = true dolphin %U
Icon = system-file-manager
Name = Open as Root
