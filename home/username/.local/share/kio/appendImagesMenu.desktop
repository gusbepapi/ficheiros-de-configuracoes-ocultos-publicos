# 🇬🇧 Appending images vertically or horizontally and save with file save dialog
# 🇵🇹 A imagem é concatenada verticalmente ou horizontalmente e guardada com o diálogo de guardar o ficheiro
# 🇪🇸 Las imágenes se concatenan verticalmente o horizontalmente y se salvar con el diálogo de salvar el archivo
#
# 🇬🇧 Dependencies:
# 🇵🇹 Dependências:
# 🇪🇸 Dependencias:
# * imagemagick
# * kdialog

[Desktop Entry]
Actions = 1appendImagesVertically; 2appendImagesHorizontally;
MimeType = image/jpeg; image/png;
Type = Service
X-KDE-ServiceTypes = KonqPopupMenu/Plugin
X-KDE-Submenu = Append images
X-KDE-Submenu[ca] = Concatenar imatges
X-KDE-Submenu[de] = Bilder anhängen
X-KDE-Submenu[el] = Επισύναψη εικόνων
X-KDE-Submenu[es] = Añadir imágenes
X-KDE-Submenu[fr] = Ajouter des images
X-KDE-Submenu[it] = Aggiungi immagini
X-KDE-Submenu[ja] = 画像を追加
X-KDE-Submenu[ka] = სურათების დამატება
X-KDE-Submenu[nl] = Oriëntatie aanpassen
X-KDE-Submenu[pt] = Adicionar imagens
X-KDE-Submenu[ro] = Adăugare imagini
X-KDE-Submenu[uk] = Додати зображення

[Desktop Action 1appendImagesVertically]
Exec = /bin/bash -c 'SAVEPATH = $(kdialog --getsavefilename "%k") && convert -append "${@}" ${SAVEPATH}' bash %F
Icon = view-split-top-bottom
Name = Vertically & Save as...
Name[ca] = Concatenar verticalment i guardar com...
Name[de] = Vertikal speichern als...
Name[el] = Αποθήκευση κάθετα ως...
Name[es] = Guardar verticalmente como...
Name[fr] = Enregistrer verticalement comme...
Name[it] = Salva verticalmente come...
Name[ja] = 縦に保存して...
Name[ka] = შეინახე ვერტიკალურად როგორც...
Name[nl] = Verticaal op & laan als…
Name[pt] = Guardar verticalmente como...
Name[ro] = Salvează vertical ca...
Name[uk] = Зберегти вертикально як...

[Desktop Action 2appendImagesHorizontally]
Exec = /bin/bash -c 'SAVEPATH = $(kdialog --getsavefilename "%k") && convert +append "${@}" ${SAVEPATH}' bash %F
Icon = view-split-left-right
Name = Horizontally & save as...
Name[ca] = Concatenar horitzontalment i guardar com...
Name[de] = Horizontal speichern als...
Name[el] = Αποθήκευση οριζόντια ως...
Name[es] = Guardar horizontalmente como...
Name[fr] = Enregistrer horizontalement comme...
Name[it] = Salva orizzontalmente come...
Name[ja] = 横に保存して...
Name[ka] = შეინახე ჰორიზონტალურად როგორც...
Name[nl] = Horizontaal op&slaan als…
Name[pt] = Guardar horizontalmente como...
Name[ro] = Salvează orizontal ca...
Name[uk] = Зберегти горизонтально як...
