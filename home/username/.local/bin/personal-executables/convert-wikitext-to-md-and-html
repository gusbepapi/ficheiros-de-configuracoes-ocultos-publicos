#!/usr/bin/env python3

# https://pt.wikipedia.org/w/index.php?title=Priscila%20Fantin&action=raw
# https://pt.wikipedia.org/w/index.php?title=Priscila%20Fantin&action=raw&templates=expand
# https://starwars.fandom.com/wiki/Obi-Wan_Kenobi?action=raw
# https://starwars.fandom.com/wiki/Obi-Wan_Kenobi?action=raw&templates=expand

# Importing the necessary standard libraries
import json
import re
import subprocess
import sys
import urllib.parse
import urllib.request

def remove_element_by_class( html_content: str, tag: str, class_name: str ) -> str:
  # Defining the precise regular expression pattern to identify the target element
  pattern = re.compile( r'<' + tag + r'[^>]*class="[^"]*\b' + class_name + r'\b[^"]*"[^>]*>' )
  
  # Iterating through the text to find the tags
  while True:
    match = pattern.search( html_content )
    
    if not match:
      break
    
    start_idx = match.start()
    depth = 1
    curr_idx = match.end()
    
    while depth > 0 and curr_idx < len( html_content ):
      next_open = html_content.find( '<' + tag, curr_idx )
      next_close = html_content.find( '</' + tag + '>', curr_idx )
      
      if next_close == -1:
        break
      
      if next_open != -1 and next_open < next_close:
        # Verifying the legitimacy of the opening tag
        if html_content[next_open:next_open+len(tag)+1] in ('<' + tag + ' ', '<' + tag + '>'):
          depth += 1
          curr_idx = next_open + len(tag) + 1
        else:
          curr_idx = next_open + 1
      else:
        depth -= 1
        curr_idx = next_close + len(tag) + 3
        
    html_content = html_content[:start_idx] + html_content[curr_idx:]
    
  return html_content

def main():
  # Requesting the repository selection from the user
  print( "Choose the repository:" )
  print( "1. English Wikipedia" )
  print( "2. Portuguese Wikipedia" )
  print( "3. Wookieepedia" )

  repository = input()
  domain = ""
  language_name = ""

  if repository == "1":
    domain = "en.wikipedia.org/w"
    language_name = "english-wikipedia"
  elif repository == "2":
    domain = "pt.wikipedia.org/w"
    language_name = "portuguese-wikipedia"
  elif repository == "3":
    domain = "starwars.fandom.com"
    language_name = "wookieepedia"
  else:
    print( "Invalid option" )
    sys.exit( 1 )

  # Requesting the article name
  print( "Write an article name:" )
  article_name = input()

  # Formatting the article name for the uniform resource locator and the filenames
  article_name_url = urllib.parse.quote( article_name )
  article_name_hyphen = re.sub( r'\s+', '-', article_name ).lower()

  # Constructing the uniform resource locator strings and the destination filenames
  url = f"https://{domain}/api.php?action=parse&page={article_name_url}&format=json&prop=text|displaytitle&disableeditsection=1"
  html_filename = f"wiki-{language_name}-{article_name_hyphen}.html"
  md_filename = f"wiki-{language_name}-{article_name_hyphen}.md"

  # Downloading the parsed article content via the Action Application Programming Interface
  try:
    req = urllib.request.Request(
      url,
      headers = {
        'User-Agent': 'Mozilla/5.0'
      }
    )
    with urllib.request.urlopen( req ) as response:
      data = json.loads( response.read().decode( 'utf-8' ) )
  except urllib.error.URLError as error:
    print( f"Error downloading the article: {error}" )
    sys.exit( 1 )

  # Verifying the presence of the text content within the payload
  if "parse" not in data or "text" not in data["parse"]:
    print( "Error parsing the data because the article might not exist" )
    sys.exit( 1 )

  # Extracting the pre-rendered HyperText Markup Language content
  html_content = data["parse"]["text"]["*"]

  # Initialising the mapping dictionary to link the note identifiers to their reference origins
  note_to_ref = {}

  # Extracting the relational mappings from the superscript elements
  for match in re.finditer( r'<sup[^>]*id="(cite_ref-[^"]+)"[^>]*>.*?href="#(cite_note-[^"]+)".*?</sup>', html_content ):
    note_to_ref[match.group( 2 )] = match.group( 1 )

  # Extracting the relational mappings from the backlink definitions
  for match in re.finditer( r'id="(cite_note-[^"]+)".*?href="#(cite_ref-[^"]+)"', html_content ):
    note_to_ref[match.group( 1 )] = match.group( 2 )

  # Excising the residual edit section tags using the robust depth-counting algorithm
  html_content = remove_element_by_class( html_content, "span", "mw-editsection" )

  # Excising the invisible metadata spans completely
  html_content = remove_element_by_class( html_content, "span", "Z3988" )

  # Excising the native backlink elements to prevent the generation of the residual arrows
  html_content = remove_element_by_class( html_content, "span", "mw-cite-backlink" )

  # Unwrapping the heading divisions
  html_content = re.sub( r'<div class="[^"]*mw-heading[^"]*">(.*?)</div>', r'\1', html_content, flags=re.DOTALL )

  # Deleting the bracket spans completely
  html_content = re.sub( r'<span class="cite-bracket">.*?</span>', '', html_content, flags=re.DOTALL )

  # Appending the secure hypertext transfer protocol prefix to the protocol-relative uniform resource locators
  html_content = html_content.replace( 'href="//', 'href="https://' )
  html_content = html_content.replace( 'src="//', 'src="https://' )
  html_content = re.sub( r'srcset="([^"]*)"', lambda match: 'srcset="' + match.group( 1 ).replace( '//', 'https://' ) + '"', html_content )

  # Appending the complete uniform resource locator for the absolute-path relative addresses
  host = domain.split( '/' )[0]
  html_content = html_content.replace( 'href="/', f'href="https://{host}/' )
  html_content = html_content.replace( 'src="/', f'src="https://{host}/' )

  # Defining the inline replacer function to substitute the hyperlinks with the pure alphanumeric markers
  def inline_replacer( match ):
    note_id = match.group( 1 )
    safe_id = note_id.replace( '-', 'MINUS' ).replace( '_', 'UNDERSCORE' )
    return f'ZZZINLINE{safe_id}ZZZ'

  # Extracting the inline citations and injecting the text markers
  html_content = re.sub(
    r'<a[^>]*href="#(cite_note-[^"]+)"[^>]*>.*?</a>',
    inline_replacer,
    html_content,
    flags=( re.IGNORECASE | re.DOTALL )
  )

  # Defining the reference replacer function to inject the pure alphanumeric markers into the list items
  def ref_replacer( match ):
    tag = match.group( 1 )
    before_id = match.group( 2 )
    note_id = match.group( 3 )
    after_id = match.group( 4 )
    safe_id = note_id.replace( '-', 'MINUS' ).replace( '_', 'UNDERSCORE' )
    return f'<{tag}{before_id}{after_id}>ZZZREF{safe_id}ZZZ '

  # Extracting the footnote definitions and injecting the text markers
  html_content = re.sub(
    r'<([a-zA-Z0-9]+)([^>]*) id="(cite_note-[^"]+)"([^>]*)>',
    ref_replacer,
    html_content
  )

  # Stripping the attributes globally to prevent the generation of the incompatible syntax
  html_content = re.sub( r'\s*id="[^"]*"', '', html_content )
  html_content = re.sub( r'\s*class="[^"]*"', '', html_content )
  html_content = re.sub( r'\s*style="[^"]*"', '', html_content )
  html_content = re.sub( r'\s*typeof="[^"]*"', '', html_content )
  html_content = re.sub( r'\s*rel="[^"]*"', '', html_content )
  html_content = re.sub( r'\s*data-[a-zA-Z0-9\-]+="[^"]*"', '', html_content )

  # Saving the cleaned HyperText Markup Language file to the disk
  with open( html_filename, "w", encoding="utf-8" ) as file:
    file.write( html_content )

  print( f"Saved the parsed HyperText Markup Language file to {html_filename}" )

  # Converting the cleaned HyperText Markup Language file to the Markdown format
  md_options = [
    "pandoc",
    html_filename,
    "-f",
    "html",
    "-t",
    "markdown+grid_tables",
    "--wrap=none",
    "-o",
    md_filename
  ]

  try:
    subprocess.run( md_options, capture_output=True, text=True, check=True )
    print( f"Converted the article to the Markdown format: {md_filename}" )
  except subprocess.CalledProcessError as error:
    print( f"Error converting to Markdown: {error.stderr}" )
    sys.exit( 1 )

  # Loading the generated Markdown file for the post-processing phase
  with open( md_filename, "r", encoding="utf-8" ) as file:
    md_content = file.read()
      
  # Defining the post-processing inline replacer to format the explicit spans
  def post_inline( match ):
    safe_id = match.group( 1 )
    note_id = safe_id.replace( 'MINUS', '-' ).replace( 'UNDERSCORE', '_' )
    ref_id = note_to_ref.get( note_id, note_id.replace( 'note', 'ref' ) )
    key = note_id.replace( 'cite_note-', '' )
    return f'<span id="{ref_id}">[^{key}]</span>'

  # Restoring the inline footnotes using the exact structural logic you provided
  md_content = re.sub(
    r'ZZZINLINE(.*?)ZZZ',
    post_inline,
    md_content
  )

  # Defining the post-processing reference replacer to format the footnote definitions
  def post_ref( match ):
    safe_id = match.group( 1 )
    note_id = safe_id.replace( 'MINUS', '-' ).replace( 'UNDERSCORE', '_' )
    ref_id = note_to_ref.get( note_id, note_id.replace( 'note', 'ref' ) )
    key = note_id.replace( 'cite_note-', '' )
    return f'[^{key}]: [↑](#{ref_id}) '

  # Formatting the footnote definitions
  md_content = re.sub(
    r'^(?:\s*[\d\-]+\.\s*|\s*[\*\-]\s*)?ZZZREF(.*?)ZZZ\s*',
    post_ref,
    md_content,
    flags=re.MULTILINE
  )

  # Eliminating the residual carets generated by the pandoc utility around the superscripts
  md_content = md_content.replace( '^<span id="cite_ref', '<span id="cite_ref' )
  md_content = md_content.replace( '</span>^', '</span>' )

  # Constructing the Cascading Style Sheets block for the document terminus
  css_block = """
<style>
.footnotes li::after, 
.footnote-item::after {
    content: none !important;
}

.footnotes li {
    list-style-type: decimal;
}
</style>
"""

  # Appending the styling rules to the Markdown payload
  md_content += css_block

  # Overwriting the Markdown file with the final structure
  with open( md_filename, "w", encoding="utf-8" ) as file:
    file.write( md_content )

if __name__ == "__main__":
  main()