def load_wikipedia_colours(md_path):
  """Parsing a Wikipedia-style Markdown list of colours."""
  colours = {}
  if not os.path.exists(md_path):
    return colours

  with open(md_path, "r", encoding="utf-8") as f:
    content = f.read()

  import re

  pattern = r"\[([^\]]+)\][^\n]*?#([0-9A-Fa-f]{6})"
  matches = re.findall(pattern, content)

  for name, hex_code in matches:
    clean_name = name.split("(")[0].strip()
    colours[clean_name.lower()] = f"#{hex_code.upper()}"

  return colours

def load_colour_database():
  """Loading the standard CSS4 and Wikipedia colour databases."""
  database = get_css_colours()

  assets_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "assets")
  json_path = os.path.join(assets_dir, "safe-colours.json")

  if os.path.exists(json_path):
    try:
      with open(json_path, "r", encoding="utf-8") as f:
        wiki_colours = json.load(f)
        database.update(wiki_colours)
    except (json.JSONDecodeError, IOError) as e:
      print(f"Warning: Could not load JSON database: {e}")
  else:
    md_files = [
      "Wikipedia – Colours in alphabetical order.md",
      "Wikipedia – List of colours (alphabetical).md",
    ]
    for file_name in md_files:
      md_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), file_name)
      database.update(load_wikipedia_colours(md_path))

  return database

def srgb_to_linear(c):
  """Converting an sRGB component (0-1) to linear RGB."""
  if c <= 0.04045:
    return c / 12.92
  else:
    return ((c + 0.055) / 1.055) ** 2.4

def linear_to_xyz(r, g, b):
  """Converting linear RGB to XYZ using the sRGB matrix."""
  x = r * 0.4124564 + g * 0.3575761 + b * 0.1804375
  y = r * 0.2126729 + g * 0.7151522 + b * 0.0721750
  z = r * 0.0193339 + g * 0.1191920 + b * 0.9503041
  return x, y, z

def xyz_to_lab(x, y, z):
  """Converting XYZ to CIELAB using D65 illuminant."""
  # D65 reference white
  xn, yn, zn = 0.95047, 1.00000, 1.08883

  def f(t):
    if t > 0.008856:
      return t ** (1 / 3)
    else:
      return (7.787 * t) + (16 / 116)

  fx = f(x / xn)
  fy = f(y / yn)
  fz = f(z / zn)

  l = (116 * fy) - 16
  a = 500 * (fx - fy)
  b_val = 200 * (fy - fz)

  return l, a, b_val

def hex_to_lab(hex_code: str):
  """Converting a hex code to a CIELAB colour object."""
  hex_code = hex_code.lstrip("#")
  if len(hex_code) == 3:
    hex_code = "".join([c * 2 for c in hex_code])

  try:
    r_s, g_s, b_s = [int(hex_code[i : i + 2], 16) / 255.0 for i in (0, 2, 4)]
    r_l = srgb_to_linear(r_s)
    g_l = srgb_to_linear(g_s)
    b_l = srgb_to_linear(b_s)
    x, y, z = linear_to_xyz(r_l, g_l, b_l)
    return xyz_to_lab(x, y, z)
  except Exception:
    return None

def delta_e_cie1976(lab1, lab2):
  """Calculating the Euclidean distance in CIELAB space."""
  return math.sqrt(sum((a - b) ** 2 for a, b in zip(lab1, lab2)))

def find_closest_colour(target_hex: str, database: dict) -> dict:
  """Finding the closest colour name in the database using CIE76 distance."""
  target_lab = hex_to_lab(target_hex)
  if not target_lab:
    return {"name": "Invalid Input", "hex": "#000000"}

  min_distance = float("inf")
  closest_match = {"name": "Unknown", "hex": "#000000"}

  for name, hex_val in database.items():
    current_lab = hex_to_lab(hex_val)
    if current_lab:
      distance = delta_e_cie1976(target_lab, current_lab)
      if distance < min_distance:
        min_distance = distance
        closest_match = {"name": name.title(), "hex": hex_val.upper()}

  return closest_match

def main():
  """Main execution block."""
  if len(sys.argv) != 2:
    print("Usage: find-closest-colour <hex_code>")
    sys.exit(1)

  input_hex = sys.argv[1]
  if not input_hex.startswith("#"):
    input_hex = "#" + input_hex

  database = load_colour_database()
  if not database:
    print("Error: No colour database found.")
    sys.exit(1)

  result = find_closest_colour(input_hex, database)

  print(f"Input:   {input_hex.upper()}")
  print(f"Closest: {result['hex']} ({result['name']})")

if __name__ == "__main__":
  main()
