#!/usr/bin/env bash

# ─────────────────────────────────────────────────────────────────────────────
# Unified editor profile generation and extension installation
#
# Generating the user profiles for VSCode and every supported fork, then installing the extensions exclusively through VSCode or VSCodium
# ─────────────────────────────────────────────────────────────────────────────

# Defining the array of the supported editor environments for the profile generation
declare -a EDITORS=(
  "Code"
  "Code - Insiders"
  "VSCodium"
  "VSCodium - Insiders"
  "Cursor"
  "Antigravity"
)

# Defining the directory holding the local VSIX packages
VSIX_DIR="$HOME/Downloads/Extensions/VSCode and its forks"

# Declaring the executable holders that the detection routine will populate
CODE_BIN=""
CODIUM_BIN=""

# Declaring the array that the collection routine will populate with VSIX packages
declare -a VSIX_FILES=()

# Determining the configuration base directory for the host operating system
case "$(uname -s)" in
  Darwin)
    # Resolving the path for macOS
    CONFIG_BASE="$HOME/Library/Application Support"
    echo "Detecting macOS; resolving the configuration base to «$CONFIG_BASE»"
    ;;
  MINGW* | MSYS* | CYGWIN*)
    # Resolving the path for Windows under Git Bash, MSYS, or Cygwin
    WINDOWS_APPDATA="${APPDATA:-$HOME/AppData/Roaming}"
    if command -v cygpath > /dev/null 2>&1
    then
      # Translating the Windows path into the Unix form for the shell utilities
      CONFIG_BASE="$(cygpath -u "$WINDOWS_APPDATA")"
    else
      CONFIG_BASE="$WINDOWS_APPDATA"
    fi
    echo "Detecting Windows; resolving the configuration base to «$CONFIG_BASE»"
    ;;
  Linux)
    # Resolving the path for Linux, including the Windows Subsystem for Linux
    CONFIG_BASE="$HOME/.config"
    if grep -qiE '(microsoft|wsl)' /proc/version 2> /dev/null
    then
      echo "Detecting the Windows Subsystem for Linux; resolving the configuration base to «$CONFIG_BASE»"
    else
      echo "Detecting Linux; resolving the configuration base to «$CONFIG_BASE»"
    fi
    ;;
  *)
    # Resolving the path for any unrecognised operating system
    CONFIG_BASE="$HOME/.config"
    echo "The operating system was not recognised; resolving the configuration base to «$CONFIG_BASE»"
    ;;
esac

