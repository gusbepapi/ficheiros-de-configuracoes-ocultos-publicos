# ─────────────────────────────────────────────────────────────────────────────
# Defining the helper functions
# ─────────────────────────────────────────────────────────────────────────────

# Verifying the presence of the jq dependency that the profile generation requires
require_jq ()
{
  if ! command -v jq > /dev/null 2>&1
  then
    echo "The «jq» utility is required for the profile generation but was not found"
    echo "Installing «jq» through the system package manager is necessary before proceeding"
    exit 1
  fi
}

# Detecting the availability of the editor executables for the extension installation
detect_executables ()
{
  # Verifying the availability of the VSCode executable for the Marketplace
  if command -v code > /dev/null 2>&1
  then
    CODE_BIN="code"
    echo "Detecting the «code» executable for the Visual Studio Marketplace installations"
  else
    echo "The «code» executable is unavailable; the Marketplace installations will be skipped"
  fi

  # Verifying the availability of the VSCodium executable for the Open VSX registry
  if command -v codium > /dev/null 2>&1
  then
    CODIUM_BIN="codium"
    echo "Detecting the «codium» executable for the Open VSX registry installations"
  else
    echo "The «codium» executable is unavailable; the Open VSX installations will be skipped"
  fi
}

# Generating the random string of eight alphanumeric characters
generate_8alphanumeric ()
{
  # Extracting the random sequence from the system
  LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 8
}

# Generating a single profile within a single editor
generate_profile ()
{
  local editor="$1"
  local profile_name="$2"
  local config_dir="$CONFIG_BASE/$editor/User/globalStorage"
  local storage_json="$config_dir/storage.json"

  # Initialising the directory and the empty JSON structure when the storage file is absent
  if [[ ! -f "$storage_json" ]]
  then
    mkdir -p "$config_dir"
    echo '{"userDataProfiles": []}' > "$storage_json"
  fi

  # Skipping the generation when a profile bearing the same name already exists
  if jq -e --arg name "$profile_name" 'any(.userDataProfiles[]?; .name == $name)' "$storage_json" > /dev/null 2>&1
  then
    echo "The profile «$profile_name» already exists in «$editor»; skipping the generation"
    return 0
  fi

  # Generating the random location string of eight alphanumeric characters
  local location
  location=$(generate_8alphanumeric)

  # Appending the new profile into the JSON array
  jq --arg loc "$location" --arg name "$profile_name" \
    '.userDataProfiles += [{"location": $loc, "name": $name, "useDefaultFlags": {"snippets": true, "tasks": true, "keybindings": true}}]' \
    "$storage_json" > "$storage_json.tmp" && mv "$storage_json.tmp" "$storage_json"

  echo "Generating the profile «$profile_name» in «$editor» with the location «$location»"
}

# Collecting every VSIX package residing within the reserved directory
collect_vsix ()
{
  # Verifying the existence of the VSIX directory
  if [[ ! -d "$VSIX_DIR" ]]
  then
    echo "The VSIX directory «$VSIX_DIR» does not exist; no local packages will be installed"
    return 0
  fi

  # Iterating over the directory and retaining only the genuine files
  local vsix

  for vsix in "$VSIX_DIR"/*.vsix
  do
    if [[ -e "$vsix" ]]
    then
      VSIX_FILES+=("$vsix")
    fi
  done

  if [[ "${#VSIX_FILES[@]}" -eq 0 ]]
  then
    echo "No VSIX packages were found within «$VSIX_DIR»"
  else
    echo "Collecting ${#VSIX_FILES[@]} VSIX package(s) from «$VSIX_DIR»"
  fi
}

# Installing every collected VSIX package into the given profile through VSCodium
install_vsix_into_profile ()
{
  local profile="$1"
  local -a profile_flag=()

  # Building the profile flag only when a named profile is supplied
  if [[ -n "$profile" ]]
  then
    profile_flag=(--profile "$profile")
  fi

  # Installing every collected VSIX package exclusively from the VSCodium executable
  local vsix
  for vsix in "${VSIX_FILES[@]}"
  do
    "$CODIUM_BIN" --install-extension "$vsix" "${profile_flag[@]}"
    echo "Installing the local package «$(basename "$vsix")» into the profile «${profile:-Default}»"
  done
}

# Installing a single extension, attempting the Marketplace before the Open VSX registry
install_one_extension ()
{
  local extension="$1"
  local profile="$2"
  local -a profile_flag=()

  # Building the profile flag only when a named profile is supplied
  if [[ -n "$profile" ]]
  then
    profile_flag=(--profile "$profile")
  fi

  # Attempting the installation from the Visual Studio Marketplace through VSCode
  if [[ -n "$CODE_BIN" ]]
  then
    if "$CODE_BIN" --install-extension "$extension" "${profile_flag[@]}"
    then
      echo "Installing the extension «$extension» into the profile «${profile:-Default}» from the Marketplace"
      return 0
    fi
  fi

  # Falling back to the Open VSX registry through VSCodium
  if [[ -n "$CODIUM_BIN" ]]
  then
    if "$CODIUM_BIN" --install-extension "$extension" "${profile_flag[@]}"
    then
      echo "Installing the extension «$extension» into the profile «${profile:-Default}» from the Open VSX registry"
      return 0
    fi
  fi

  echo "The extension «$extension» could not be located for the profile «${profile:-Default}»"
  return 1
}

# Installing every member of the named array into the given profile
install_array_into_profile ()
{
  local -n items_ref="$1"
  local profile="$2"

  local item
  for item in "${items_ref[@]}"
  do
    install_one_extension "$item" "$profile"
  done
}

# ─────────────────────────────────────────────────────────────────────────────
# Executing the unified workflow
# ─────────────────────────────────────────────────────────────────────────────

# Verifying the presence of the jq dependency
require_jq

# Detecting the editor executables
detect_executables

# Generating every profile within every supported editor before any installation
echo "Generating the profiles for every editor and its forks"
for editor in "${EDITORS[@]}"
do
  for pair in "${PROFILE_REGISTRY[@]}"
  do
    generate_profile "$editor" "${pair%%=*}"
  done
done

# Collecting the local VSIX packages
collect_vsix

# Installing the local VSIX packages into the default profile and every named profile
if [[ -n "$CODIUM_BIN" && "${#VSIX_FILES[@]}" -gt 0 ]]
then
  echo "Installing the local VSIX packages from VSCodium"
  install_vsix_into_profile ""
  for pair in "${PROFILE_REGISTRY[@]}"
  do
    install_vsix_into_profile "${pair%%=*}"
  done
elif [[ -z "$CODIUM_BIN" && "${#VSIX_FILES[@]}" -gt 0 ]]
then
  echo "The «codium» executable is unavailable; skipping the local VSIX installation"
fi

# Installing the global arrays into the default profile and every named profile
echo "Installing the global extensions into every profile"
for array_name in "${GLOBAL_ARRAYS[@]}"
do
  install_array_into_profile "$array_name" ""
  for pair in "${PROFILE_REGISTRY[@]}"
  do
    install_array_into_profile "$array_name" "${pair%%=*}"
  done
done

# Installing each profile-specific array into its corresponding profile
echo "Installing the profile-specific extensions"
for pair in "${PROFILE_REGISTRY[@]}"
do
  install_array_into_profile "${pair#*=}" "${pair%%=*}"
done

# Announcing the successful completion of the operation
echo "The unified profile generation and extension installation has completed"
