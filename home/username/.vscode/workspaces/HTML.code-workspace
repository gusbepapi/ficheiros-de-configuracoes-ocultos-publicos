{
	"folders": [],
	"settings": 
	{
        "[html]": 
        {
            "editor.defaultFormatter": "vscode.html-language-features",
        },
        "[javascript]": 
        {
            "editor.defaultFormatter": "vscode.typescript-language-features"
        },
		"colorize.decoration_type": "underline",
        "colorize.colorized_colors": 
        [
            "HEXA",
            "HSL",
            "RGB"
        ],
        "colorize.colorized_variables": 
        [
            "CSS",
            "LESS",
            "SASS"
        ],
        "colorize.enable_search_variables": true,
        "colorize.include": 
        [
            // Absolute files
            "~/.config/kitty/kitty.conf",
            // Relative extensions
            ".bbcode",
            ".conf",
            ".ipynb",
            ".json",
            ".txt",
            ".zsh"
        ],
        "colorize.languages": 
        [
            "apacheconf",
            "bbcode",
            "css",
            "html",
            "jupyter",
            "javascript",
            "json",
            "jsonc",
            "json5",
            "less",
            "plaintext",
            "postcss",
            "python",
            "sass",
            "scss",
            "shellscript",
            "stylus",
            "svg",
            "xml"
        ],
        "csscomb.preset": "~/.vscode-insiders/settings/formatters/csscomb.json",
        "csscomb.supportEmbeddedStyles": true,
        "css.validate": false,
        "html-css-class-completion.enableEmmetSupport": true,
        "html.format.indentInnerHtml": true,
        "html.format.wrapAttributes": "preserve",
        "html.format.wrapLineLength": 0,
        "html.suggest.html5": true,
        "javascript.format.insertSpaceBeforeFunctionParenthesis": true,
        // FIVE SERVER
        "fiveServer.browser": ["microsoft-edge-dev --inprivate"],
        "fiveServer.port": 1984,
        "scss.validate": false,
        "stylelint.validate": 
        [
            "css"
        ],
        "workbench.colorTheme": "Steam Punk"
	},
	"extensions": {
		"recommendations": [
            "agutierrezr.emmet-keybindings",
            "ahebrank.yaml2json",
            "anderseandersen.html-class-suggestions",
            "danileao.css-variables-autocomplete",
            "dbaeumer.vscode-eslint",
            "deepkolos.change-color",
            "dotjoshjohnson.xml",
            "ecmel.vscode-html-css",
            "eiminsasete.apacheconf-snippets",
            "espresso3389.insert-file",
            "grantbartlett.scss-allman-formatter",
            "huang-an-sheng.youtube-embed-snippets",
            "jakewilson.vscode-picture",
            "javierartero.equality",
            "kamikillerto.vscode-colorize",
            "kisstkondoros.vscode-gutter-preview",
            "liamhammett.inline-parameters",
            "mrmlnc.vscode-apache",
            "mrmlnc.vscode-attrs-sorter",
            "mrmlnc.vscode-csscomb",
            "mrmlnc.vscode-scss",
            "ms-vscode.vscode-typescript-next",
            "nadim-vscode.html-meta-tags-hero",
            "ohansemmanuel.css-grid-snippets",
            "pascalreitermann93.vscode-yaml-sort",
            "pranaygp.vscode-css-peek",
            "redhat.vscode-xml",
            "redhat.vscode-yaml",
            "sainoba.px-to-rem",
            "solnurkarim.html-to-css-autocompletion",
            "stylelint.vscode-stylelint",
            "syler.sass-indented",
            "tock.vscode-css-custom-properties",
            "vincaslt.highlight-matching-tag",
            "xabikos.javascriptsnippets",
            "yandeu.five-server",
            "ysemeniuk.emmet-live",
            "zignd.html-css-class-completion",
        ]
	}
}