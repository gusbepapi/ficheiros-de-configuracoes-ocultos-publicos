{
	"folders": [],
	"settings": 
	{
		"[html]": 
		{
			"editor.defaultFormatter": "vscode.html-language-features",
		},
		"[javascript]": 
		{
			"editor.defaultFormatter": "vscode.typescript-language-features"
		},
		"[markdown]": 
		{
			"editor.defaultFormatter": "yzhang.markdown-all-in-one"
		},
		"color-highlight.languages": 
		[
			"*"
		],
		"color-highlight.markerType": "underline",
		"csscomb.preset": "~/.vscode-insiders/settings/csscomb.json",
		"csscomb.supportEmbeddedStyles": true,
		"css.validate": false,
		"html-css-class-completion.enableEmmetSupport": true,
		"html.format.indentInnerHtml": true,
		"html.format.wrapAttributes": "preserve",
		"html.format.wrapLineLength": 0,
		"html.suggest.html5": true,
		"javascript.format.insertSpaceBeforeFunctionParenthesis": true,
		"jekyll-run.commandLineArguments": "bundler exec jekyll serve --host localhost --port 1984 --ssl-cert ./localhost.pem --ssl-key ./localhost-key.pem",
		// MARKDOWN CHECKBOX
		"markdown-checkbox.dateWhenChecked": false,
		"markdown-checkbox.strikeThroughWhenChecked": false,
		// MARKDOWN ALL IN ONE
		"markdown.extension.print.absoluteImgPath": false,
		"markdown.extension.print.imgToBase64": true,
		"markdown.extension.print.includeVscodeStylesheets": false,
		"markdown.extension.print.onFileSave": false,
		"markdown.extension.toc.plaintext": false,
		"markdown.extension.toc.updateOnSave": false,
		// MAKRODWN PASTE 
		"MarkdownPaste.rules": 
		[
			{
				"regex": "^(?:https?://)?(?:(?:(?:www\\.?)?youtube\\.com(?:/(?:(?:watch\\?.*?v=([^&\\s]+).*)|))?))",
				"options": "g",
				"replace": "[![](https://img.youtube.com/vi/$1/0.jpg)](https://www.youtube.com/watch?v=$1)"
			},
			{
				"regex": "^(https?://.*)",
				"options": "ig",
				"replace": "[]($1)"
			}
		],
		"MarkdownPaste.enableImgTag": true,
		// MICROSOFT MARKDOWN LANGUAGE FEATURES
		"markdown.preview.breaks": true,
		"scss.validate": false,
		"stylelint.validate": 
		[
			"css"
		]
	},
	"extensions": 
	{
		"recommendations": 
		[
			"agutierrezr.emmet-keybindings",
			"alperg.markdown-vscode",
			"anderseandersen.html-class-suggestions",
			"axetroy.vscode-markdown-script",
			"ban.spellright",
			"bierner.markdown-checkbox",
			"bierner.markdown-footnotes",
			"bierner.markdown-image-size",
			"bierner.markdown-mermaid",
			"catonif.markdown-collapsible",
			"dbaeumer.vscode-eslint",
			"dedsec727.jekyll-run",
			"ecmel.vscode-html-css",
			"evondev.generate-css-class",
			"fuji-nakahara.markdown-ruby",
			"ginfuru.ginfuru-vscode-jekyll-syntax",
			"ginfuru.vscode-jekyll-snippets",
			"grantbartlett.scss-allman-formatter",
			"houkanshan.vscode-markdown-footnote",
			"hwencc.html-tag-wrapper",
			"jbockle.jbockle-format-files",
			"jebbs.markdown-extended",
			"jjaakko.markdown-kbd",
			"mathiassoeholm.markdown-link-updater",
			"mathpix.vscode-mathpix-markdown",
			"mrmlnc.vscode-attrs-sorter",
			"mrmlnc.vscode-csscomb",
			"mrmlnc.vscode-scss",
			"nadim-vscode.html-meta-tags-hero",
			"naumovs.color-highlight",
			"pascalreitermann93.vscode-yaml-sort",
			"pkief.markdown-checkbox",
			"pranaygp.vscode-css-peek",
			"rebornix.ruby",
			"redhat.vscode-yaml",
			"skn0tt.markdown-link-expander",
			"solnurkarim.html-to-css-autocompletion",
			"stylelint.vscode-stylelint",
			"svsool.markdown-memo",
			"syler.sass-indented",
			"telesoho.vscode-markdown-paste-image",
			"tock.vscode-css-custom-properties",
			"tsutsu3.markdown-named-codeblocks",
			"vincaslt.highlight-matching-tag",
			"wingrunr21.vscode-ruby",
			"ysemeniuk.emmet-live",
			"yzhang.markdown-all-in-one",
			"zignd.html-css-class-completion",
		]
	}
}