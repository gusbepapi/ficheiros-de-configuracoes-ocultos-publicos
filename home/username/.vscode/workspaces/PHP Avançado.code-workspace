	"folders": 
	[],
	"settings": 
	{
		"[javascript]": 
		{
				"editor.defaultFormatter": "vscode.typescript-language-features"
		},
    "colorize.decoration_type": "underline",
    "colorize.colorized_colors": 
    [
        "HEXA",
        "HSL",
        "RGB"
    ],
    "colorize.colorized_variables": 
    [
        "CSS",
        "LESS",
        "SASS"
    ],
    "colorize.enable_search_variables": true,
    "colorize.include": 
    [
        // Absolute files
        "~/.config/kitty/kitty.conf",
        // Relative extensions
        ".bbcode",
        ".conf",
        ".ipynb",
        ".json",
        ".txt",
        ".zsh"
    ],
    "colorize.languages": 
    [
        "apacheconf",
        "bbcode",
        "css",
        "html",
        "jupyter",
        "javascript",
        "json",
        "jsonc",
        "json5",
        "less",
        "plaintext",
        "postcss",
        "python",
        "sass",
        "scss",
        "shellscript",
        "stylus",
        "svg",
        "xml"
    ],
		"csscomb.preset": "~/.vscode-insiders/settings/csscomb.json",
		"csscomb.supportEmbeddedStyles": true,
		"css.validate": false,
		"git.ignoreLimitWarning": true,
		"html-css-class-completion.enableEmmetSupport": true,
		"html.format.indentInnerHtml": true,
		"html.format.wrapAttributes": "preserve",
		"html.format.wrapLineLength": 0,
		"html.suggest.html5": true,
		"javascript.format.insertSpaceBeforeFunctionParenthesis": true,
		"phpserver.browser": "firefox",
		"phpserver.port": 1984,
		"php-cs-fixer.autoFixByBracket": true,
		"php-cs-fixer.formatHtml": true,
		"php.suggest.basic": false,
		"php.validate.enable": false,
		"scss.validate": false,
		"spellright.documentTypes": 
		[
			"css",
			"html",
			"php",
			"scss",
		],
		"spellright.language": [],
		"workbench.colorTheme": "Steam Punk"
	},
}