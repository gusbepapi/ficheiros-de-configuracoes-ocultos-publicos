#!/usr/bin/env bash

# Configuring the history of Bash only, because `shopt`, `PROMPT_COMMAND` and `history -r` do not exist elsewhere

##================##
## History
##================##

# Retaining every command without ceiling
HISTCONTROL='ignoredups'
HISTSIZE=-1
HISTFILESIZE=-1

# Recording a timestamp against each entry, so an archive kept indefinitely stays legible
HISTTIMEFORMAT='%F %T  '

HISTFOLDER="$HOME/.bash_histories"
HISTFILEEXT="history"

shopt -s histappend
mkdir -p "$HISTFOLDER"

# Writing one file per session, so concurrent shells never overwrite one another
HISTFILE="$HISTFOLDER/$(date +%Y-%m-%d_%H-%M-%S_%N).$HISTFILEEXT"

# Flushing after every command, so nothing is lost to an abrupt termination
PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

histfile_latest=$(find "$HISTFOLDER" -name "*.$HISTFILEEXT" -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 1 | cut -d' ' -f2-)

if [ -n "$histfile_latest" ] && [ -f "$histfile_latest" ];
then
  history -r "$histfile_latest"
fi

unset histfile_latest

# Searching the complete history archive on disk, across every session ever recorded
# Usage: histsearch <pattern>
function histsearch()
{
  local folder="${HISTFOLDER:-$HOME/.bash_histories}"
  local pattern="${1:?Usage: histsearch <pattern>}"

  if [ ! -d "${folder}" ];
  then
    printf 'The history archive «%s» does not exist\n' "${folder}" >&2
    return 1
  fi

  grep -rh --color=never -- "${pattern}" "${folder}" 2>/dev/null | sort -u
}

# Reporting which session file each match came from, the filename carrying the date
# Usage: histwhen <pattern>
function histwhen()
{
  local folder="${HISTFOLDER:-$HOME/.bash_histories}"
  local pattern="${1:?Usage: histwhen <pattern>}"

  grep -r --color=never -- "${pattern}" "${folder}" 2>/dev/null | sed "s|^${folder}/||"
}

# Loading the entire archive into the current shell, on demand rather than at start-up
function histload()
{
  local folder="${HISTFOLDER:-$HOME/.bash_histories}"
  local file
  local count=0

  while IFS= read -r file;
  do
    history -r "${file}"
    count=$(( count + 1 ))
  done < <(find "${folder}" -name "*.history" -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | cut -d' ' -f2-)

  printf 'Loaded %d session files into this shell\n' "${count}"
}
