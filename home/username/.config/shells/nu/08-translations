let lang = match $env.LANG {
  $it if $it =~ '^ca' => "ca"
  $it if $it =~ '^de' => "de"
  $it if $it =~ '^el' => "el"
  $it if $it =~ '^es' => "es"
  $it if $it =~ '^fr' => "fr"
  $it if $it =~ '^it' => "it"
  $it if $it =~ '^ka' => "ka"
  $it if $it =~ '^nl' => "nl"
  $it if $it =~ '^pt_BR' => "pt_BR"
  $it if $it =~ '^pt' => "pt"
  $it if $it =~ '_' => "_"
}

# Now you can access the variables from the translations object
let cannot_extract_error = $translations | get $lang | get cannot_extract_error
let invalid_format_error = $translations | get $lang | get invalid_format_error
let ethernet_up_label = $translations | get $lang | get ethernet_up_label
let ethernet_lower_up_label = $translations | get $lang | get ethernet_lower_up_label
