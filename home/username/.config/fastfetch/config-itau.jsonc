// Converted from config-itau.conf by convert-neofetch-to-fastfetch
// The original used the image backend «on»; pass an image with `fastfetch --logo FILE`
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "right": 3
    },
    "color": {
      "1": "38;5;202",
      "2": "38;5;24",
      "3": "38;5;11"
    }
