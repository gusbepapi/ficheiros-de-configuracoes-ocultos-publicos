# 🇬🇧 Used in i3-blocks: ~/.config/i3/conf/i3blocks.conf together with: ~/.config/global/scripts/global_powerprofiles
# 🇵🇹 Utilizado em i3-blocks: ~/.config/i3/conf/i3blocks.conf juntamente com: ~/.config/global/scripts/global_powerprofiles
# 🇪🇸 Utilizado en i3-blocks: ~/.config/i3/conf/i3blocks.conf junto con: ~/.config/global/scripts/global_powerprofiles

# 🇬🇧 Script to show a current power profile
# 🇵🇹 Script para mostrar o perfil de energia actual
# 🇪🇸 Script para mostrar el perfil de energía actual
current_profile=$(/usr/bin/powerprofilesctl get)
echo "$current_profile"