#!/usr/bin/env bash

# 🇬🇧 Using rofi or zenity to change system runstate thanks to systemd.
# 🇵🇹 A utilizar rofi ou zenity para alterar o estado de funcionamento do sistema graças ao systemd.
# 🇪🇸 Usando rofi o zenity para cambiar el estado de ejecución del sistema gracias a systemd.

# 🇬🇧 Note: This currently relies on associative array support in the shell.
# 🇵🇹 Nota: Actualmente depende do suporte a arrays associativas no shell.
# 🇪🇸 Nota: Actualmente depende del soporte a arrays asociativas en el shell.

# 🇬🇧 Inspired from i3pystatus wiki:
# 🇵🇹 Inspirado na wiki do i3pystatus:
# 🇪🇸 Inspirado en la wiki de i3pystatus:
# https://github.com/enkore/i3pystatus/wiki/Shutdown-Menu

# 🇬🇧 Copyright 2015 Benjamin Chrétien <chretien at lirmm dot fr>
# 🇵🇹 Direitos de autor 2015 Benjamin Chrétien <chretien at lirmm dot fr>
# 🇪🇸 Derechos de autor 2015 Benjamin Chrétien <chretien at lirmm dot fr>

# 🇬🇧 Licenced under the GPLv3 or later.
# 🇵🇹 Licenciado sob a GPLv3 ou posterior.
# 🇪🇸 Licenciado bajo la GPLv3 o posterior.

#######################################
### 🇬🇧 BEGINNING OF CONFIGURATION   ###
### 🇵🇹 INÍCIO DA CONFIGURAÇÃO       ###
### 🇪🇸 INICIO DE LA CONFIGURACIÓN   ###
#######################################

# 🇬🇧 Variables exportations
# 🇵🇹 Exportação de variáveis
# 🇪🇸 Exportación de variables
DESKTOP_ENVIRONMENT=$(echo $XDG_CURRENT_DESKTOP | awk '{print tolower($0)}')

# 🇬🇧 To use a custom lock script
# 🇵🇹 Utilizar um executável de bloqueio personalizado
# 🇪🇸 Utilizar un script de bloqueo personalizado
if [[ "$DESKTOP_ENVIRONMENT" == "i3" ]]; then
  # LOCKSCRIPT="i3lock-fancy -m pixelize"
else
  # LOCKSCRIPT="swaylock-fancy -m pixelize"
fi


# 🇬🇧 Colours: BG (background), FG (foreground) and HL (highlighted)
# 🇵🇹 Cores: BG (fundo), FG (primeiro plano) e HL (destacado)
# 🇪🇸 Colores: BG (fondo), FG (primer plano) y HL (destacado)
FG_COLOR="#bbbbbb"
BG_COLOR="#111111"
HLFG_COLOR="#111111"
HLBG_COLOR="#bbbbbb"
BORDER_COLOR="#222222"

# 🇬🇧 Options not related to colors (most rofi options do not work anymore)
# 🇵🇹 Opções não relacionadas com as cores (a maioria das opções do rofi já não funcionam)
# 🇪🇸 Opciones no relacionadas con los colores (la mayoría de las opciones de rofi ya no funcionan)
ROFI_OPTIONS=(-theme ~/.config/rofi/powermenu.rasi)

# 🇬🇧 zenity options
# 🇵🇹 Opções do zenity
# 🇪🇸 Opciones de zenity
ZENITY_TITLE="Power Menu"
ZENITY_TEXT="Action:"
ZENITY_OPTIONS=(--column= --hide-header)

###################################
### 🇬🇧 END OF CONFIGURATION     ###
### 🇵🇹 FIM DA CONFIGURAÇÃO      ###
### 🇪🇸 FIN DE LA CONFIGURACIÓN  ###
###################################

# 🇬🇧 Whether to ask for user's confirmation
# 🇵🇹 Se pedir confirmação ao utilizador
# 🇪🇸 Si pedir confirmación al usuario
enable_confirmation=false

# 🇬🇧 Preferred launcher if both are available
# 🇵🇹 Executável preferido se ambos estiverem disponíveis
# 🇪🇸 Ejecutable preferido si ambos están disponibles
preferred_launcher="rofi"

usage="$(basename "$0") [-h] [-c] [-p name] -- display a menu for shutdown, reboot, lock etc.
where:
    -h  show this help text
    -c  ask for user confirmation
    -p  preferred launcher (rofi or zenity)
This script depends on:
  - systemd,
  - i3,
  - rofi or zenity."

# 🇬🇧 Checking whether the user-defined launcher is valid
# 🇵🇹 Verificar se o executável definido pelo utilizador é válido
# 🇪🇸 Verificar si el ejecutable definido por el usuario es válido
launcher_list=(rofi zenity)

function check_launcher() 
{
  if [[ ! "${launcher_list[@]}" =~ (^|[[:space:]])"$1"($|[[:space:]]) ]]; then
    echo "Supported launchers: ${launcher_list[*]}"
    exit 1
  else
    # 🇬🇧 Getting an array with unique elements and preferred launcher first
    # 🇵🇹 Obter um array com elementos únicos e executável preferido primeiro
    # 🇪🇸 Obtener una array con elementos únicos y ejecutable preferido primero
    
    # 🇬🇧 Note: uniq expects a sorted list, so we can not use it
    # 🇵🇹 Nota: uniq espera uma lista ordenada, por isso, não podemos utilizá-lo
    # 🇪🇸 Nota: uniq espera una lista ordenada, por lo que no podemos utilizarlo
    i=1
    launcher_list=($(for l in "$1" "${launcher_list[@]}"; do printf "%i %s\n" "$i" "$l"; let i+=1; done \
      | sort -uk2 | sort -nk1 | cut -d' ' -f2- | tr '\n' ' '))
  fi
}

# 🇬🇧 Parsing the CLI arguments
# 🇵🇹 Analisar os argumentos da CLI
# 🇪🇸 Analizar los argumentos de la CLI
while getopts "hcp:" option; do
  case "${option}" in
    h) echo "${usage}"
       exit 0
       ;;
    c) enable_confirmation=true
       ;;
    p) preferred_launcher="${OPTARG}"
       check_launcher "${preferred_launcher}"
       ;;
    *) exit 1
       ;;
  esac
done

# 🇬🇧 Checking whether a command exists
# 🇵🇹 Verificar se um comando existe
# 🇪🇸 Verificar si un comando existe
function command_exists() 
{
  command -v "$1" &> /dev/null 2>&1
}

# 🇬🇧 systemctl required
# 🇵🇹 systemctl é necessário
# 🇪🇸 systemctl es necesario
if ! command_exists systemctl ; then
  exit 1
fi

# 🇬🇧 Menu defined as an associative array
# 🇵🇹 Menu definido como um array associativo
# 🇪🇸 Menú definido como un array asociativo
typeset -A menu

# 🇬🇧 Menu with keys or commands
# 🇵🇹 Menu com chaves ou comandos
# 🇪🇸 Menú con claves o comandos

if [[ "${DESKTOP_ENVIRONMENT}" == "i3" ]]; then
  menu=(
    [ Lock]="i3lock-fancy -m pixelize"
    [  Suspend]="systemctl suspend"
    [ Hibernate]="systemctl hibernate"
    [ Reboot]="systemctl reboot"
    [ Shutdown]="systemctl poweroff"
    [ Logout]="i3-msg exit"
    [ Cancel]=""
  )
else
  menu=(
    [ Lock]="swaylock-fancy -m pixelize"
    [  Suspend]="systemctl suspend"
    [ Hibernate]="systemctl hibernate"
    [ Reboot]="systemctl reboot"
    [ Shutdown]="systemctl poweroff"
    [ Logout]="swaymsg exit"
    [ Cancel]=""
  )
fi

menu_nrows=${#menu[@]}

# 🇬🇧 Menu entries that may trigger a confirmation message
# 🇵🇹 Entradas do menu que podem desencadear uma mensagem de confirmação
# 🇪🇸 Entradas del menú que pueden desencadenar un mensaje de confirmación
menu_confirm="Lock Suspend Hibernate Reboot Shutdown Logout Cancel"

launcher_exe=""
launcher_options=""
rofi_colors=""

function prepare_launcher() 
{
  if [[ "$1" == "rofi" ]]; then
    rofi_colors=(-bc "${BORDER_COLOR}" -bg "${BG_COLOR}" -fg "${FG_COLOR}" \
        -hlfg "${HLFG_COLOR}" -hlbg "${HLBG_COLOR}")
    launcher_exe="rofi"
    launcher_options=(-dmenu -i -lines "${menu_nrows}" -p "${ROFI_TEXT}" \
        "${rofi_colors}" "${ROFI_OPTIONS[@]}")
  elif [[ "$1" == "zenity" ]]; then
    launcher_exe="zenity"
    launcher_options=(--list --title="${ZENITY_TITLE}" --text="${ZENITY_TEXT}" \
        "${ZENITY_OPTIONS[@]}")
  fi
}

for l in "${launcher_list[@]}"; do
  if command_exists "${l}" ; then
    prepare_launcher "${l}"
    break
  fi
done

# 🇬🇧 No launcher available
# 🇵🇹 Nenhum executável disponível
# 🇪🇸 Ningún ejecutable disponible
if [[ -z "${launcher_exe}" ]]; then
  exit 1
fi

launcher=(${launcher_exe} "${launcher_options[@]}")
selection="$(printf '%s\n' "${!menu[@]}" | sort | "${launcher[@]}")"

function ask_confirmation() {
  if [ "${launcher_exe}" == "rofi" ]; then
    confirmed=$(echo -e "Yes\nNo" | rofi -dmenu -i -lines 2 -p "${selection}?" \
      "${rofi_colors}" "${ROFI_OPTIONS[@]}")
    [ "${confirmed}" == "Yes" ] && confirmed=0
  elif [ "${launcher_exe}" == "zenity" ]; then
    zenity --question --text "Are you sure you want to ${selection,,}?"
    confirmed=$?
  fi

  if [ "${confirmed}" == 0 ]; then
    if [[ "$DESKTOP_ENVIRONMENT" == "i3" ]]; then
      i3-msg -q "exec ${menu[${selection}]}"
    else
      swaymsg -q "exec ${menu[${selection}]}"
    fi
  fi
}

if [[ $? -eq 0 && ! -z ${selection} ]]; then
  if [[ "${enable_confirmation}" = true && \
        ${menu_confirm} =~ (^|[[:space:]])"${selection}"($|[[:space:]]) ]]; then
    ask_confirmation
  else
    if [[ "$DESKTOP_ENVIRONMENT" == "i3" ]]; then
      i3-msg -q "exec ${menu[${selection}]}"
    else
      swaymsg -q "exec ${menu[${selection}]}"
    fi
  fi
fi