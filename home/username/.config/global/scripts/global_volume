# 🇵🇹 Licenciado sob a GPLv3 ou posterior.
# 🇪🇸 Licenciado bajo la GPLv3 o posterior.

# ------------------------------------------------------------------------

# 🇬🇧 The second parameter overrides the mixer selection
# 🇵🇹 O segundo parâmetro substitui a seleção do mixer
# 🇪🇸 El segundo parámetro sustituye la selección del mixer

# 🇬🇧 For PulseAudio users, eventually use "pulse"
# 🇵🇹 Para utilizadores de PulseAudio, eventualmente utilize "pulse"
# 🇪🇸 Para usuarios de PulseAudio, eventualmente utilice "pulse"

# 🇬🇧 For Jack/Jack2 users, use "jackplug"
# 🇵🇹 Para utilizadores de Jack/Jack2, utilize "jackplug"
# 🇪🇸 Para usuarios de Jack/Jack2, utilice "jackplug"

# 🇬🇧 For ALSA users, you may use "default" for your primary card or you may use hw:# where # is the number of the card desired
# 🇵🇹 Para utilizadores de ALSA, pode utilizar "default" para a sua placa primária ou pode utilizar hw:# onde # é o número da placa desejada
# 🇪🇸 Para usuarios de ALSA, puede utilizar "default" para su placa primaria o puede utilizar hw:# donde # es el número de la placa deseada

if [[ -z "$MIXER" ]] ; then
    MIXER="default"
    if command -v pulseaudio >/dev/null 2>&1 && pulseaudio --check ; then
        # 🇬🇧 pulseaudio is running, but not all installations use "pulse"
        # 🇵🇹 pulseaudio está a correr, mas nem todas as instalações utilizam "pulse"
        # 🇪🇸 pulseaudio está corriendo, pero no todas las instalaciones utilizan "pulse"
        if amixer -D pulse info >/dev/null 2>&1 ; then
            MIXER="pulse"
        fi
    fi
    [ -n "$(lsmod | grep jack)" ] && MIXER="jackplug"
    MIXER="${2:-$MIXER}"
fi

# 🇬🇧 The instance option sets the control to report and configure
# 🇵🇹 A opção de instância define o controlo a reportar e configurar
# 🇪🇸 La opción de instancia define el control a reportar y configurar

# 🇬🇧 This defaults to the first control of your selected mixer
# 🇵🇹 Isto por padrão é o primeiro controlo do seu mixer selecionado
# 🇪🇸 Esto por defecto es el primer control de su mixer seleccionado

# 🇬🇧 For a list of the available, use `amixer -D $Your_Mixer scontrols`
# 🇵🇹 Para uma lista dos disponíveis, utilize `amixer -D $Seu_Mixer scontrols`
# 🇪🇸 Para una lista de los disponibles, utilice `amixer -D $Su_Mixer scontrols`
if [[ -z "$SCONTROL" ]] ; then
    SCONTROL="${BLOCK_INSTANCE:-$(amixer -D $MIXER scontrols |
                      sed -n "s/Simple mixer control '\([^']*\)',0/\1/p" |
                      head -n1
                    )}"
fi

# 🇬🇧 The first parameter sets the step to change the volume by (and units to display)
# 🇵🇹 O primeiro parâmetro define o passo para alterar o volume (e as unidades a exibir)
# 🇪🇸 El primer parámetro define el paso para cambiar el volumen (y las unidades a mostrar)

# 🇬🇧 This may be in in % or dB (eg. 5% or 3dB)
# 🇵🇹 Isto pode ser em % ou dB (ex. 5% ou 3dB)
# 🇪🇸 Esto puede ser en % o dB (ej. 5% o 3dB)
if [[ -z "$STEP" ]] ; then
    STEP="${1:-5%}"
fi

NATURAL_MAPPING=${NATURAL_MAPPING:-0}
if [[ "$NATURAL_MAPPING" != "0" ]] ; then
    AMIXER_PARAMS="-M"
fi

capability() 
{ 
  # 🇬🇧 Returning "Capture" if the device is a capture device
  # 🇵🇹 Retorna "Capture" se o dispositivo é um dispositivo de captura
  # 🇪🇸 Retorna "Capture" si el dispositivo es un dispositivo de captura
  amixer $AMIXER_PARAMS -D $MIXER get $SCONTROL |
    sed -n "s/  Capabilities:.*cvolume.*/Capture/p"
}

volume() 
{
  amixer $AMIXER_PARAMS -D $MIXER get $SCONTROL $(capability)
}

format() 
{
  
  perl_filter='if (/.*\[(\d+%)\] (\[(-?\d+.\d+dB)\] )?\[(on|off)\]/)'
  perl_filter+='{CORE::say $4 eq "off" ? "MUTE" : "'

  # 🇬🇧 If dB was selected, print that instead
  # 🇵🇹 Se dB foi selecionado, imprima isso em vez disso
  # 🇪🇸 Si dB fue seleccionado, imprima eso en vez de eso
  perl_filter+=$([[ $STEP = *dB ]] && echo '$3' || echo '$1')
  perl_filter+='"; exit}'
  output=$(perl -ne "$perl_filter")
  echo "$LABEL$output"
}

# ------------------------------------------------------------------------

case $BLOCK_BUTTON in
  # 🇬🇧 right click, mute/unmute
  # 🇵🇹 clique direito, silenciar/desilenciar
  # 🇪🇸 clic derecho, silenciar/desilenciar
  3) amixer $AMIXER_PARAMS -q -D $MIXER sset $SCONTROL $(capability) toggle ;;

  # 🇬🇧 scroll up, increase
  # 🇵🇹 deslocar para cima, aumentar
  # 🇪🇸 desplazar hacia arriba, aumentar
  4) amixer $AMIXER_PARAMS -q -D $MIXER sset $SCONTROL $(capability) ${STEP}+ unmute ;; 
  
  # 🇬🇧 scroll down, decrease
  # 🇵🇹 deslocar para baixo, diminuir
  # 🇪🇸 desplazar hacia abajo, disminuir
  5) amixer $AMIXER_PARAMS -q -D $MIXER sset $SCONTROL $(capability) ${STEP}- unmute ;; 
esac

volume | format
