#!/usr/bin/env bash

COLOR_RUN=${COLOR_RUN:-#00FF00}
COLOR_DOWN=${COLOR_DOWN:-#FF0000}
com=$(pidof insync)
retval=$?

echo "Insync"
echo "Insync"

# 🇬🇧 On click, we open Insync
# 🇵🇹 Ao clicar, abrimos o Insync
# 🇪🇸 Al hacer clic, abrimos Insync
[[ -z "${BLOCK_BUTTON}" ]] || insync show

if [ $retval -eq 0 ]; then
	echo $COLOR_RUN
else
	echo $COLOR_DOWN
fi