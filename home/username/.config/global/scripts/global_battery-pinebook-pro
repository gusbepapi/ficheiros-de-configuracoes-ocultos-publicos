#!/usr/bin/env bash

# 🇬🇧 Simple Shell script for i3blocks on Pinebook Pro
# 🇵🇹 Executável simples em Shell para i3blocks no Pinebook Pro
# 🇪🇸 Script simple en Shell para i3blocks en Pinebook Pro

# 🇬🇧 Author: Gerhard S. <geri123 arriba gmx dot net>
# 🇵🇹 Autor: Gerhard S. <geri123 arriba gmx dot net>
# 🇪🇸 Autor: Gerhard S. <geri123 arriba gmx dot net>

# 🇬🇧 battery-symbols: On Manjaro, you need to install awesome-terminal-fonts package!
# 🇵🇹 battery-symbols: Em Manjaro, você precisa instalar o pacote awesome-terminal-fonts!
# 🇪🇸 battery-symbols: En Manjaro, ¡necesitas instalar el paquete awesome-terminal-fonts!
PERCENT=$(cat /sys/class/power_supply/cw2015-battery/capacity)
STATUS=$(cat /sys/class/power_supply/cw2015-battery/status)
case $((
 $PERCENT >= 0 && $PERCENT <= 20 ? 1 :
 $PERCENT > 20 && $PERCENT <= 40 ? 2 :
 $PERCENT > 40 && $PERCENT <= 60 ? 3 :
 $PERCENT > 60 && $PERCENT <= 80 ? 4 : 5)) in
#
       (1) echo $STATUS:"" :$PERCENT%;;
       (2) echo $STATUS:"" :$PERCENT%;;
       (3) echo $STATUS:"" :$PERCENT%;;
       (4) echo $STATUS:"" :$PERCENT%;;
       (5) echo $STATUS:"" :$PERCENT%;;
esac
