#!/usr/bin/env bash

# 🇬🇧 SCREEN RECORDING
# 🇵🇹 GRAVAÇÃO DE ECRÃ
# 🇪🇸 GRABACIÓN DE PANTALLA

## 🇬🇧 Variables exportations
## 🇵🇹 Exportação de variáveis
## 🇪🇸 Exportación de variables
DESKTOP_ENVIRONMENT=$(echo $XDG_CURRENT_DESKTOP | awk '{print tolower($0)}')

set $mode_recording "<span foreground='$base0A'>雷</span>  \
<span foreground='$base05'><b>Ecrã</b></span> <span foreground='$base0A'>(<b>w</b>)</span> \
<span foreground='$base01'>—</span> \
<span foreground='$base05'><b>Ecrã (+ Mic)</b></span> <span foreground='$base0A'>(<b>Shift+w</b>)</span> \
<span foreground='$base01'>—</span> \
<span foreground='$base05'><b>Região</b></span> <span foreground='$base0A'>(<b>r</b>)</span> \
<span foreground='$base01'>—</span> \
<span foreground='$base05'><b>Região (+ Mic)</b></span> <span foreground='$base0A'>(<b>Shift+r</b>)</span>"

set $mode_recording_on "<span foreground='$base0A'>壘</span>  \
<span foreground='$base05'><b>Finalizar</b></span> <span foreground='$base0A'>(<b>ESC</b>)</span>"

mode --pango_markup $mode_recording_on 
{
    bindsym Escape exec killall -s SIGINT wf-recorder, mode "default"
}

if [[ "$DESKTOP_ENVIRONMENT" = "i3" ]]; then
    mode --pango_markup $mode_recording 
    {
        bindsym w exec wf-recorder -g "$(slurp)" -f ~/Videos/$(date +%Y-%m-%d_%H-%M-%S).mp4, mode $mode_recording_on
        bindsym Shift+w exec wf-recorder -g "$(slurp)" -f ~/Videos/$(date +%Y-%m-%d_%H-%M-%S).mp4 -c, mode $mode_recording_on
        bindsym r exec wf-recorder -g "$(slurp -f '%x,%y %wx%h')" -f ~/Videos/$(date +%Y-%m-%d_%H-%M-%S).mp4, mode $mode_recording_on
        bindsym Shift+r exec wf-recorder -g "$(slurp -f '%x,%y %wx%h')" -f ~/Videos/$(date +%Y-%m-%d_%H-%M-%S).mp4 -c, mode $mode_recording_on

       ## 🇬🇧 Returning to default mode.
       ## 🇵🇹 Retornar ao modo padrão.
       ## 🇪🇸 Regresar al modo predeterminado.
       bindsym Escape mode "default"
       bindsym Return mode "default"
    }
else
    mode --pango_markup $mode_recording 
    {
       bindsym w exec killall -s SIGINT wf-recorder || wf-recorder --audio=0 -o $(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name') -f ~/Vídeos/recording-$(date +'%Y-%m-%d-%H%M%S').mp4, mode $mode_recording_on
       bindsym Shift+w exec killall -s SIGINT wf-recorder || wf-recorder --audio -o $(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name') -f ~/Vídeos/recording-$(date +'%Y-%m-%d-%H%M%S').mp4, mode $mode_recording_on
       bindsym r exec killall -s SIGINT wf-recorder || wf-recorder --audio=0 -g "$(slurp -d)" -f ~/Vídeos/recording-$(date +'%Y-%m-%d-%H%M%S').mp4, mode $mode_recording_on
       bindsym Shift+r exec killall -s SIGINT wf-recorder || wf-recorder --audio -g "$(slurp -d)" \ -f ~/Vídeos/recording-$(date +'%Y-%m-%d-%H%M%S').mp4, mode $mode_recording_on       
       
       ## 🇬🇧 Returning to default mode.
       ## 🇵🇹 Retornar ao modo padrão.
       ## 🇪🇸 Regresar al modo predeterminado.
       bindsym Escape mode "default"
       bindsym Return mode "default"
    }
fi

## 🇧🇷 Iniciar - Modo de Gravação
## 🇬🇧 Launch – Recording Mode
bindsym $mod+Shift+R mode $mode_recording

