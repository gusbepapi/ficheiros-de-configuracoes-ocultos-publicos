#!/usr/bin/env bash

# 🇬🇧 SYSTEM APPLICATIONS
# 🇵🇹 APLICAÇÕES DO SISTEMA
# 🇪🇸 APLICACIONES DEL SISTEMA

## 🇬🇧 Overriding mode for specific applications
## 🇵🇹 Modo de substituição para aplicativos específicos
## 🇪🇸 Modo de sustitución para aplicaciones específicas
for_window [instance="lxappearance"] floating enable
for_window [title="File Operation Progress"] floating enable, border pixel 1, sticky enable, resize set width 40 ppt height 30 ppt
for_window [app_id="(?i)firefox" title="Library"] floating enable, border pixel 1, sticky enable, resize set width 30 ppt height 40 ppt
for_window [app_id="thunderbird" title=".*Reminder"] floating enable
for_window [app_id="floating_shell_portrait"] floating enable, border pixel 1, sticky enable, resize set width 30 ppt height 40 ppt
for_window [app_id="floating_shell_landscape"] floating enable, border pixel 1, sticky enable, resize set width 40 ppt height 30 ppt
for_window [app_id="Manjaro.manjaro-settings-manager"] floating enable
for_window [title="Picture in picture"] floating enable, sticky enable
for_window [title="nmtui"] floating enable

## 🇬🇧 Inhibiting idle
## 🇵🇹 Inibir ocioso
## 🇪🇸 Inhibir ocioso
for_window [app_id="(?i)chrome"] inhibit_idle fullscreen
for_window [app_id="(?i)chromium"] inhibit_idle fullscreen
for_window [app_id="firefox"] inhibit_idle fullscreen
for_window [instance="google-chrome-unstable"] inhibit_idle fullscreen