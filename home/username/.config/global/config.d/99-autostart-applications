#!/usr/bin/env bash

# 🇬🇧 Enabling idle mode
# 🇵🇹 Ativar modo inativo
# 🇪🇸 Activar modo inactivo
exec $idle

# 🇬🇧 Autostarting background applications
# 🇵🇹 Iniciar osaplicativos automaticamente
# 🇪🇸 Iniciar aplicaciones automáticamente
exec
{
  /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
  mako
  autotiling
}

# 🇬🇧 Finding if Insync exists
# 🇵🇹 Procurar se o Insync existe
# 🇪🇸 Buscar si Insync existe
if [[ -x /usr/bin/insync ]]; then
  insync_hide="insync hide"
else
  insync_hide=""
fi

exec_always 
{
	/bin/bash -c "sleep 2; $insync_hide"
	/bin/bash -c "sleep 20; /usr/bin/xmodmap $HOME/.Xmodmap"
  /bin/bash -c "xmodmap 'keycode 118 = Multi_key'"
}