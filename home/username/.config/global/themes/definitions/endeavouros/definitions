# 🇬🇧 Some global theme specific variables for GTK, Kvantum, QT and X11, and GUI and terminal fonts
# 🇵🇹 Algumas variáveis específicas do tema global para GTK, Kvantum, QT e X11, e fontes de GUI e terminal
# 🇪🇸 Algunas variables específicas del tema global para GTK, Kvantum, QT y X11, y fuentes de GUI y terminal
## 🇬🇧 X11 cursor
## 🇵🇹 Cursor X11
## 🇪🇸 Cursor X11
set $cursor-theme xcursor-breeze
## 🇬🇧 GTK theme
## 🇵🇹 Tema GTK
## 🇪🇸 Tema GTK
set $gtk-theme Matcha-dark-sea
## 🇬🇧 GUI font
## 🇵🇹 Fonte de GUI
## 🇪🇸 Fuente de GUI
set $gui-font Roboto 11
## 🇬🇧 GUI icon theme
## 🇵🇹 Tema de ícones de GUI
## 🇪🇸 Tema de iconos de GUI
set $icon-theme Papirus-Dark-Maia
## 🇬🇧 Kvantum theme
## 🇵🇹 Tema Kvantum
## 🇪🇸 Tema Kvantum
set $kvantum-theme Matcha-Dark
## 🇬🇧 Terminal font
## 🇵🇹 Fonte de terminal
## 🇪🇸 Fuente de terminal
set $term-font PragmataPro Mono 11

## 🇬🇧 To define colours variables:
## 🇵🇹 Definir variáveis de cores:
## 🇪🇸 Definir variables de colores:
set $black		          #000000
set $darkblue		        #08052b
set $darkbluetrans	    #08052be6
set $darkgrey		        #383c4a
set $grey		            #b0b5bd
set $lightblue		      #5294e2
set $mediumgrey		      #8b8b8b
set $purple		          #e345ff
set $urgentred		      #e53935
set $white		          #ffffff
set $yellowbrown	      #e1b700

# 🇬🇧 Seting $background-color for $darkblue
# 🇵🇹 A definir $background-color para $darkblue
# 🇪🇸 Definiendo $background-color para $darkblue
set $background-color $darkblue

# 🇬🇧 Seting $text-color for $white
# 🇵🇹 A definir $text-color para $white
# 🇪🇸 Definiendo $text-color para $white
set $text-color $white

# 🇬🇧 Seting $selection-color for $purple
# 🇵🇹 A definir $selection-color para $purple
# 🇪🇸 Definiendo $selection-color para $purple
set $selection-color $purple

# 🇬🇧 Seting $accent-color for $lightblue
# 🇵🇹 A definir $accent-color para $lightblue
# 🇪🇸 Definiendo $accent-color para $lightblue
set $accent-color $lightblue

# 🇬🇧 Basic colour configuration using the Base16 variables for windows and borders
# 🇵🇹 Configuração básica de cores utilizando as variáveis Base16 para janelas e bordas
# 🇪🇸 Configuración básica de colores utilizando las variables Base16 para ventanas y bordes
# 🇬🇧 Property Name            Border      Background      Text      Indicator       Child Border
# 🇵🇹 Nome da Propriedade      Borda       Fundo           Texto     Indicador       Borda do Filho
# 🇪🇸 Nombre de la Propiedad   Borde       Fondo           Texto     Indicador       Borde del Hijo
client.focused                $lightblue  $darkblue       $white	  $mediumgrey     $mediumgrey
client.focused_inactive       $darkblue   $darkblue       $grey	    $black	        $black
client.unfocused              $darkblue   $darkblue       $grey	    $darkgrey       $darkgrey
client.urgent                 $urgentred  $urgentred      $white	  $yellowbrown    $yellowbrown
client.placeholder            $purple     $darkbluetrans  $white    $yellowbrown    $lightblue
client.background             $darkblue
