# 🇬🇧 Some global theme specific variables for GTK, Kvantum, QT and X11, and GUI and terminal fonts
# 🇵🇹 Algumas variáveis específicas do tema global para GTK, Kvantum, QT e X11, e fontes de GUI e terminal
# 🇪🇸 Algunas variables específicas del tema global para GTK, Kvantum, QT y X11, y fuentes de GUI y terminal
## 🇬🇧 X11 cursor
## 🇵🇹 Cursor X11
## 🇪🇸 Cursor X11
set $cursor-theme xcursor-breeze
## 🇬🇧 GTK theme
## 🇵🇹 Tema GTK
## 🇪🇸 Tema GTK
set $gtk-theme Matcha-dark-sea
## 🇬🇧 GUI font
## 🇵🇹 Fonte de GUI
## 🇪🇸 Fuente de GUI
set $gui-font Roboto 11
## 🇬🇧 GUI icon theme
## 🇵🇹 Tema de ícones de GUI
## 🇪🇸 Tema de iconos de GUI
set $icon-theme Papirus-Dark-Maia
## 🇬🇧 Kvantum theme
## 🇵🇹 Tema Kvantum
## 🇪🇸 Tema Kvantum
set $kvantum-theme Matcha-Dark
## 🇬🇧 Terminal font
## 🇵🇹 Fonte de terminal
## 🇪🇸 Fuente de terminal
set $term-font PragmataPro Mono 11

set $color0  #091013
set $color1  #002e18
set $color2  #6fa64c
set $color3  #595900
set $color4  #00cb6b
set $color5  #412a4d
set $color6  #125459
set $color7  #002e19
set $color8  #333333
set $color9  #00381d
set $color10 #90d762
set $color11 #e2e500
set $color12 #00ff87
set $color13 #412a4d
set $color14 #176c73
set $color15 #00381e

# 🇬🇧 Seting $background-color for $color0
# 🇵🇹 A definir $background-color para $color0
# 🇪🇸 Definiendo $background-color para $color0
set $background-color #070c0e

# 🇬🇧 Seting $text-color for $color6
# 🇵🇹 A definir $text-color para $color6
# 🇪🇸 Definiendo $text-color para $color6
set $text-color #28380d

# 🇬🇧 Seting $selection-color for $color1
# 🇵🇹 A definir $selection-color para $color1
# 🇪🇸 Definiendo $selection-color para $color1
set $selection-color #0f191c

# 🇬🇧 Seting $accent-color for $color12
# 🇵🇹 A definir $accent-color para $color12
# 🇪🇸 Definiendo $accent-color para $color12
set $accent-color #00ff87

# 🇬🇧 Basic colour configuration using the Base16 variables for windows and borders
# 🇵🇹 Configuração básica de cores utilizando as variáveis Base16 para janelas e bordas
# 🇪🇸 Configuración básica de colores utilizando las variables Base16 para ventanas y bordes
# 🇬🇧 Property Name            Border  Background    Text      Indicator   Child Border
# 🇵🇹 Nome da Propriedade      Borda   Fundo         Texto     Indicador   Borda do Filho
# 🇪🇸 Nombre de la Propiedad   Borde   Fondo         Texto     Indicador   Borde del Hijo
client.focused                $color5 $color12      $color0   $color12    $color12
client.focused_inactive       $color1 $color1       $color5   $color3     $color1
client.unfocused              $color1 $color0       $color5   $color1     $color1
client.urgent                 $color8 $color8       $color0   $color8     $color8
client.placeholder            $color0 $color0       $color5   $color0     $color0
client.background             $color7
