#!/usr/bin/env bash

# 🇬🇧 To add this script to your WM startup file.
# 🇵🇹 Adicionar este script ao seu ficheiro de arranque WM.
# 🇪🇸 Añadir este script a su archivo de inicio WM.
DIR="$HOME/.config/polybar/conf/themes/material"

# 🇬🇧 Terminating already running bar instances
# 🇵🇹 A terminar instâncias de barra já em execução
# 🇪🇸 A terminar instancias de barra ya en ejecución
killall -q polybar

# 🇬🇧 Waiting until the processes have been shut down
# 🇵🇹 A aguardar até que os processos tenham sido desligados
# 🇪🇸 A esperar hasta que los procesos hayan sido apagados
while pgrep -u $UID -x polybar >/dev/null; do sleep 1; done

# 🇬🇧 Launching the bar
# 🇵🇹 A lançar a barra
# 🇪🇸 A lanzar la barra
# polybar -q main -c "$DIR"/config.ini &
polybar -q main -c home/.config/polybar/config.ini &
