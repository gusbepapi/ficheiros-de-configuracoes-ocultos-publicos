" 🇬🇧 Source UI plugins
" 🇵🇹 Origens dos plugins da interface do utilizador
" 🇪🇸 Fuentes de los plugins de la interfaz de usuario
set runtimepath+=~/.config/nvim/plugged/vim-airline
set runtimepath+=~/.config/nvim/plugged/onedark.vim

" 🇬🇧 Source syntax plugins
" 🇵🇹 Origens dos plugins de sintaxe
" 🇪🇸 Fuentes de los plugins de sintaxis
set runtimepath+=~/.config/nvim/plugged/vim-polyglot

source ~/.config/nvim/conf.d/02-appearance.vim
source ~/.config/nvim/conf.d/03-keybinds.vim
source ~/.config/nvim/conf.d/06-misc.vim
source ~/.config/nvim/conf.d/07-clipboardfix.vim
