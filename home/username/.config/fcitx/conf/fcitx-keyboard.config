[Keyboard]
# 🇬🇧 To commit with extra-space when choosing candidate word
# 🇵🇹 Confirmar com espaço extra quando escolher palavra candidata
# 🇪🇸 Confirmar con espacio extra cuando elegir palabra candidata

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# CommitWithExtraSpace=False

# 🇬🇧 Choose a key modifier
# 🇵🇹 Escolha um modificador de tecla
# 🇪🇸 Elija un modificador de tecla

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# None Alt Ctrl Shift
# ChooseModifier=Alt

# 🇬🇧 To toggle the word hint
# 🇵🇹 Alternar o indicador de palavra
# 🇪🇸 Alternar el indicador de palabra
# HotkeyToggleWordHint=CTRL_ALT_H

# 🇬🇧 Minimum length to trigger word hint
# 🇵🇹 Comprimento mínimo para ativar o indicador de palavra
# 🇪🇸 Longitud mínima para activar el indicador de palabra
# MinimumHintLength=1

# 🇬🇧 Maximum length of spell hint list
# 🇵🇹 Comprimento máximo da lista de dicas de ortografia
# 🇪🇸 Longitud máxima de la lista de sugerencias de ortografía
# MaximumHintLength=5

# 🇬🇧 To use the enter button to commit the existing string
# 🇵🇹 Usar o botão Enter para confirmar a cadeia existente
# 🇪🇸 Usar el botón Enter para confirmar la cadena existente

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# UseEnterToCommit=False

# 🇬🇧 To add a current input buffer to user dictionary
# 🇵🇹 Adicionar um buffer de entrada atual ao dicionário do utilizador
# 🇪🇸 Añadir un búfer de entrada actual al diccionario del usuario
# HotkeyAddToUserDict=CTRL_ALT_N

