[Clipboard]
# 🇬🇧 To save the clipboard history to file
# 🇵🇹 Guardar o histórico da área de transferência para um ficheiro
# 🇪🇸 Guardar el historial del portapapeles en un archivo

# 🇬🇧 Available Value:
# 🇵🇹 Valores Disponíveis:
# 🇪🇸 Valores Disponibles:
# True False
# SaveHistoryToFile=True

# 🇬🇧 Length of clipboard history to save
# 🇵🇹 Tamanho do histórico da área de transferência a guardar
# 🇪🇸 Tamaño del historial del portapapeles a guardar
# HistoryLength=5

# 🇬🇧 Maximum length of each candidate word
# 🇵🇹 Tamanho máximo de cada palavra candidata
# 🇪🇸 Tamaño máximo de cada palabra candidata
# CandidateMaxLength=43

# 🇬🇧 Triggering the key for the clipboard history list
# 🇵🇹 Tecla de ativação para a lista do histórico da área de transferência
# 🇪🇸 Tecla de activación para la lista del historial del portapapeles
# TriggerKey=CTRL_;

# 🇬🇧 Using the select text
# 🇵🇹 Usar o texto selecionado
# 🇪🇸 Usar el texto seleccionado

# 🇬🇧 Available Value:
# 🇵🇹 Valores Disponíveis:
# 🇪🇸 Valores Disponibles:
# True False
# UsePrimary=True

# 🇬🇧 Choose a key modifier
# 🇵🇹 Escolha um modificador de tecla
# 🇪🇸 Elija un modificador de tecla

# 🇬🇧 Available Value:
# 🇵🇹 Valores Disponíveis:
# 🇪🇸 Valores Disponibles:
# None Alt Ctrl Shift
# ChooseModifier=None

# 🇬🇧 To ignore the blank selections
# 🇵🇹 Ignorar as seleções em branco
# 🇪🇸 Ignorar las selecciones en blanco

# 🇬🇧 Available Value:
# 🇵🇹 Valores Disponíveis:
# 🇪🇸 Valores Disponibles:
# True False
# IgnoreBlank=True