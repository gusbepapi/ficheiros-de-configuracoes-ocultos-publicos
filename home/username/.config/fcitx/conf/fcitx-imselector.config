[IMSelector]
# 🇬🇧 Local input method select key
# 🇵🇹 Tecla de seleção de método de entrada local
# 🇪🇸 Tecla de selección de método de entrada local
# LocalInputMethodSelectKey=

# 🇬🇧 Global input method select key
# 🇵🇹 Tecla de seleção de método de entrada global
# 🇪🇸 Tecla de selección de método de entrada global
# GlobalInputMethodSelectKey=

# 🇬🇧 Clearing the local input method
# 🇵🇹 Limpar o método de entrada local
# 🇪🇸 Limpiar el método de entrada local
# ClearLocal=

[GlobalSelector]
# 🇬🇧 To switch to the first input method
# 🇵🇹 Alternar para o primeiro método de entrada
# 🇪🇸 Alternar al primer método de entrada
#IM1=

# 🇬🇧 To switch to the second input method
# 🇵🇹 Alternar para o segundo método de entrada
# 🇪🇸 Alternar al segundo método de entrada
#IM2=

# 🇬🇧 To switch to the third input method
# 🇵🇹 Alternar para o terceiro método de entrada
# 🇪🇸 Alternar al tercer método de entrada
#IM3=

# 🇬🇧 To switch to the fourth input method
# 🇵🇹 Alternar para o quarto método de entrada
# 🇪🇸 Alternar al cuarto método de entrada
#IM4=

# 🇬🇧 To switch to the fifth input method
# 🇵🇹 Alternar para o quinto método de entrada
# 🇪🇸 Alternar al quinto método de entrada
#IM5=

# 🇬🇧 To switch to the sixth input method
# 🇵🇹 Alternar para o sexto método de entrada
# 🇪🇸 Alternar al sexto método de entrada
#IM6=

# 🇬🇧 To switch to the seventh input method
# 🇵🇹 Alternar para o sétimo método de entrada
# 🇪🇸 Alternar al séptimo método de entrada
#IM7=

# 🇬🇧 To switch to the eighth input method
# 🇵🇹 Alternar para o oitavo método de entrada
# 🇪🇸 Alternar al octavo método de entrada
#IM8=

# 🇬🇧 To switch to the ninth input method
# 🇵🇹 Alternar para o nono método de entrada
# 🇪🇸 Alternar al noveno método de entrada
#IM9=

