[QuickPhrase]
# 🇬🇧 To trigger key for the quick phrase
# 🇵🇹 Chave para ativar a frase rápida
# 🇪🇸 Tecla para activar la frase rápida

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# None Semicolon Grave
# QuickPhraseTriggerKey=Semicolon

# 🇬🇧 Alternative trigger key for the quick phrase
# 🇵🇹 Chave alternativa para ativar a frase rápida
# 🇪🇸 Tecla alternativa para activar la frase rápida
# AlternativeTriggerKey=

# 🇬🇧 Choose a key modifier
# 🇵🇹 Escolha um modificador de tecla
# 🇪🇸 Elija un modificador de tecla

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# None Alt Ctrl Shift
# ChooseModifier=None

# 🇬🇧 Do not show spell hint
# 🇵🇹 Não mostrar a dica de ortografia
# 🇪🇸 No mostrar la sugerencia de ortografía

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# DisableSpell=False

# 🇬🇧 Maximum hint length
# 🇵🇹 Comprimento máximo da dica
# 🇪🇸 Longitud máxima de la sugerencia
# MaximumHintLength=2

