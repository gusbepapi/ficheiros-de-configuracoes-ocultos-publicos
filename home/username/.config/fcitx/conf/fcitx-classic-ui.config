[ClassicUI]
# 🇬🇧 Status panel X position
# 🇵🇹 Posição X do painel de estado
# 🇪🇸 Posición X del panel de estado
MainWindowOffsetX=1525

# 🇬🇧 Status panel Y position
# 🇵🇹 Posição Y do painel de estado
# 🇪🇸 Posición Y del panel de estado
MainWindowOffsetY=0

# 🇬🇧 Font size
# 🇵🇹 Tamanho da fonte
# 🇪🇸 Tamaño de fuente
# FontSize=12

# 🇬🇧 Font
# 🇵🇹 Fonte
# 🇪🇸 Fuente
# Font=Sans

# 🇬🇧 Menu Font
# 🇵🇹 Fonte do menu
# 🇪🇸 Fuente del menú
# MenuFont=Sans

# 🇬🇧 Font localisation to display
# 🇵🇹 Localização da fonte a exibir
# 🇪🇸 Localización de la fuente a mostrar
# FontLocale=zh_CN.UTF-8
# 🇬🇧 To use system tray icon
# 🇵🇹 Utilizar o ícone da área de notificação
# 🇪🇸 Usar el icono de la bandeja del sistema

# 🇬🇧 Available Value:
# 🇵🇹 Valores Disponíveis:
# 🇪🇸 Valores Disponibles:
# True False
UseTray=False

# 🇬🇧 Status panel hiding mode
# 🇵🇹 Modo de esconder o painel de estado
# 🇪🇸 Modo de ocultar el panel de estado

# 🇬🇧 Available Value:
# 🇵🇹 Valores Disponíveis:
# 🇪🇸 Valores Disponibles:
# Show Auto Hide
MainWindowHideMode=Show

# 🇬🇧 Vertical candidate words list
# 🇵🇹 Lista vertical de palavras candidatas
# 🇪🇸 Lista vertical de palabras candidatas

# 🇬🇧 Available Value:
# 🇵🇹 Valores Disponíveis:
# 🇪🇸 Valores Disponibles:
# True False
# VerticalList=False

# 🇬🇧 Skin name
# 🇵🇹 Nome da pele
# 🇪🇸 Nombre de la piel
SkinType=dark

