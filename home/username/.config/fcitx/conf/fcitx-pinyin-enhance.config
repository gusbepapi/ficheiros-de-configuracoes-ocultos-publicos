[Pinyin Enhance]
# 🇬🇧 Treating abbreviated pinyin as English
# 🇵🇹 Tratando o pinyin abreviado como inglês
# 🇪🇸 Tratando el pinyin abreviado como inglés

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# ShortAsEnglish=False

# 🇬🇧 To allow to replace the first candidate
# 🇵🇹 Permitir substituir o primeiro candidato
# 🇪🇸 Permitir reemplazar el primer candidato

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# AllowReplaceFirst=True

# 🇬🇧 Do not show spell hint
# 🇵🇹 Não mostrar dica de ortografia
# 🇪🇸 No mostrar sugerencia de ortografia

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# DisableSpell=False

# 🇬🇧 Maximum hint length
# 🇵🇹 Comprimento máximo da dica
# 🇪🇸 Longitud máxima de la sugerencia
# MaximumHintLength=1

# 🇬🇧 Hotkey for inputing the character from phrase
# 🇵🇹 Atalho para inserir os caracteres da frase
# 🇪🇸 Atajo para insertar los caracteres de la frase
# InputCharFromPhraseString=[]

# 🇬🇧 Hotkey for switching to inputing the character from phrase mode
# 🇵🇹 Atalho para alternar para o modo de inserção de caracteres da frase
# 🇪🇸 Atajo para alternar a modo de inserción de caracteres de la frase
# InputCharFromPhraseKey=

# 🇬🇧 To disable the pinyin symbol
# 🇵🇹 Desativar o símbolo de pinyin
# 🇪🇸 Desactivar el símbolo de pinyin

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# DisableSym=False

# 🇬🇧 Stroke input trigger length
# 🇵🇹 Comprimento do gatilho de entrada de traço
# 🇪🇸 Longitud del disparador de entrada de trazo
# StrokeThresh=2

# 🇬🇧 Maximum results from stroke input
# 🇵🇹 Resultados máximos da entrada de traço
# 🇪🇸 Resultados máximos de la entrada de trazo
# StrokeLimit=3

