[X Keyboard]
# 🇬🇧 To allow to override system XKB settings
# 🇵🇹 Permitir a substituição das configurações do sistema do XKB
# 🇪🇸 Permitir sobrescribir la configuración del sistema XKB

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# OverrideSystemXKBSettings=True

# 🇬🇧 To use the layout of first keyboard input method in list as default layout
# 🇵🇹 Usar o layout do primeiro método de entrada de teclado na lista como o layout padrão
# 🇪🇸 Usar el diseño del primer método de entrada de teclado en la lista como el diseño predeterminado

# 🇬🇧 Available Value:
# 🇵🇹 Valor Disponível:
# 🇪🇸 Valor Disponible:
# True False
# UseFirstKeyboardIMAsDefaultLayout=True

# 🇬🇧 xmodmap command
# 🇵🇹 Comando de xmodmap
# 🇪🇸 Comando de xmodmap
# XModmapCommand=xmodmap

# 🇬🇧 Applying this custom xmodmap script after the layout change
# 🇵🇹 Aplicar este script personalizado de xmodmap após a alteração do layout
# 🇪🇸 Aplicar este script personalizado de xmodmap después de cambiar el diseño
# CustomXModmapScript=

