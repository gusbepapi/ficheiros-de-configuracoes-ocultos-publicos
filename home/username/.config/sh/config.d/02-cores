## 🇬🇧 Observe that the hexadecimal codes for colours are compatible only with ZSH. For Bash, we provided a function that converts it to the ANSI RGB code because our goal is to unify Bash, Fish and ZSH
## 🇵🇹 Observa que os códigos hexadecimais para as cores são compatíveis apenas com ZSH. Para Bash, fornecemos uma função que os converte para os códigos ANSI RGB porque o nosso objectivo é unificar Bash, Fish e ZSH
## 🇪🇸 Tenga en cuenta que los códigos hexadecimales para los colores son compatibles solo con ZSH. Para Bash, proporcionamos una función que los convierte a los códigos ANSI RGB porque nuestro objetivo es unificar Bash, Fish y ZSH.

# Define function to convert hex color to RGB ANSI format
hex_to_rgb() 
{
  # Remove the hash character from the beginning of the hex code
  hex=${1#"#"}
  # Extract the red, green, and blue components from the hex code
  r=${hex:0:2}
  g=${hex:2:2}
  b=${hex:4:2}
  # Convert the hex values to decimal
  r=$(printf "%d" "0x$r")
  g=$(printf "%d" "0x$g")
  b=$(printf "%d" "0x$b")
  # Print the ANSI RGB code
  printf "%d;%d;%d" "$r" "$g" "$b"
}

