--format 'bestvideo[height<=1080]+bestaudio/best[height<=1080]'
--add-metadata
--embed-subs
--prefer-ffmpeg 
--sub-lang en
--write-sub
--yes-playlist

# 🇬🇧 Do not copy the mtime
# 🇵🇹 Não copie o mtime
# 🇪🇸 No copie el mtime
--no-mtime

# 🇬🇧 Save all videos under Movies directory in your home directory
# 🇵🇹 Guarde todos os vídeos no directório Vídeos em seu directório pessoal
# 🇪🇸 Guarde todos los vídeos en el directorio Películas en su directorio personal
-o ~/Vídeos/%(title)s.%(ext)s