# 🇬🇧 cURL configuration file
# 🇵🇹 Ficheiro de configuração cURL
# 🇪🇸 Archivo de configuración cURL
# http://curl.haxx.se/docs/manpage.html

# 🇬🇧 Setting the user agent as Firefox
# 🇵🇹 Definir o agente de utilizador como Firefox
# 🇪🇸 Definir el agente de usuario como Firefox
user-agent = "Mozilla/5.0 (Windows NT 6.1; rv:31.0) Gecko/20100101 Firefox/31.0"

# 🇬🇧 When following a redirect, automatically setting the previous URL as the referrer
# 🇵🇹 Ao seguir um redirecionamento, definir automaticamente o URL anterior como referenciador
# 🇪🇸 Al seguir un redireccionamiento, definir automáticamente la URL anterior como referente
referer = ";auto"

# 🇬🇧 Following HTTP redirects
# 🇵🇹 Seguir o redirecionamentos HTTP
# 🇪🇸 Seguir los redireccionamientos HTTP
location

# 🇬🇧 Showing error messages
# 🇵🇹 Mostrar mensagens de erro
# 🇪🇸 Mostrar mensajes de error
show-error

# 🇬🇧 Showing the progress using a progress meter
# 🇵🇹 Mostrar o progresso utilizando um medidor de progresso
# 🇪🇸 Mostrar el progreso utilizando un medidor de progreso
progress-bar

# 🇬🇧 Setting timestamp of remote file to local file if found
# 🇵🇹 Definir o registo de data e hora do ficheiro remoto como ficheiro local, se encontrado
# 🇪🇸 Definir la marca de tiempo del archivo remoto como archivo local, si se encuentra
remote-time
