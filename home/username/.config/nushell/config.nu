# Sourcing the modular shell configuration
# Nushell resolves «source» at parse time, so every module is listed explicitly and a missing module is a parse error
source ~/.config/shells/nu/01-exports
source ~/.config/shells/nu/02-functions
source ~/.config/shells/nu/03-aliases
source ~/.config/shells/nu/06-history
source ~/.config/shells/nu/07-colours
source ~/.config/shells/nu/08-translations
