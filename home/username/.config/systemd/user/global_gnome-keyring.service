[Unit]
# 🇬🇧 Stores passwords and encryption keys
# 🇧🇷 Armazena senhas e chaves de criptografia
# 🇵🇹 Armazena palavras-passe e chaves de criptografia
# 🇪🇸 Almacena contraseñas y claves de cif
Description=Stores passwords and encryption keys
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/gnome-keyring-daemon --start --components=secrets 

[Install]
WantedBy=i3-session.target,sway-session.target
