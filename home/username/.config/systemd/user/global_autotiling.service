[Unit]
# 🇬🇧 Script for i3 and Sway to automatically switch the horizontal or vertical window split orientation
# 🇧🇷 Script para o sway e o i3 alternarem automaticamente a orientação de divisão da janela horizontal ou vertical
# 🇵🇹 Executável para o sway e o i3 alternarem automaticamente a orientação de divisão da janela horizontal ou vertical
# 🇪🇸 Script para i3 e Sway para alternar automáticamente la orientación de la división de la ventana horizontal o vertical
Description=Script for i3 and Sway to automatically switch the horizontal or vertical window split orientation
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/autotiling
Type==simple

[Install]
WantedBy=i3-session.target,sway-session.target
