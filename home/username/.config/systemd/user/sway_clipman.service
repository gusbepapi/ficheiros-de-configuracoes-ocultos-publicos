[Unit]
# 🇬🇧 A clipboard manager for Wayland
# 🇧🇷 Um gerenciador de área de transferência para Wayland
# 🇵🇹 Um gestor de área de transferência para Wayland
# 🇪🇸 Un administrador de portapapeles para Wayland
Description=A clipboard manager for Wayland
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/wl-paste -t text --watch clipman store
Type=simple

[Install]
WantedBy=sway-session.target
