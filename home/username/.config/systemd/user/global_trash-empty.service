[Unit]
# 🇬🇧 Removes files older than a week from trash can
# 🇧🇷 Remove arquivos com mais de uma semana da lixeira
# 🇵🇹 Remove ficheiros com mais de uma semana da lixeira
# 🇪🇸 Elimina archivos con más de una semana de la papelera
Description=Removes files older than a week from trash can

[Service]
Type=oneshot
ExecStart=/usr/bin/trash-empty 7
