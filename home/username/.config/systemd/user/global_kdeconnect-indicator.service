[Unit]
# 🇬🇧 KDE Connect tray indicator
# 🇵🇹 Indicador da bandeja do KDE Connect
# 🇪🇸 Indicador de la bandeja de KDE Connect
Description=KDE Connect tray indicator
PartOf=graphical-session.target
Requires=kdeconnectd.service

[Service]
Type=simple
ExecStart=/usr/bin/kdeconnect-indicator

[Install]
WantedBy=i3-session.target,sway-session.target
