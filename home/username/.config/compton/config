backend = "glx";
glx-no-stencil = true;
glx-copy-from-front = false;
glx-swap-method = 1;
inactive-opacity-override = true;

# 🇬🇧 To fix tearing
# 🇵🇹 Corrigir o rasgo
# 🇪🇸 Corregir el desgarro
vsync = "opengl-swc";
unredir-if-possible = false;
paint-on-overlay = true;

# 🇬🇧 Shadow
# 🇵🇹 Sombra
# 🇪🇸 Sombra
shadow = true;			      # 🇬🇧 Enabled client-side shadows on windows.
                          # 🇵🇹 O lado do cliente habilitado com sombras nas janelas.
                          # 🇪🇸 Las sombras del lado del cliente habilitadas en las ventanas.

no-dock-shadow = true;		# 🇬🇧 To avoid drawing shadows on dock or panel windows.
                          # 🇵🇹 Evitar desenhar as sombras nas janelas do dock ou do painel.
                          # 🇪🇸 Evitar dibujar sombras en las ventanas del dock o del panel.

no-dnd-shadow = true;		  # 🇬🇧 To avoid drawing shadows on DND windows.
                          # 🇵🇹 Não desenhar sombras nas janelas DND.
                          # 🇪🇸 Evitar dibujar sombras nas janelas DND.

shadow-radius = 10;		    # 🇬🇧 The blur radius for shadows. (default 12)
                          # 🇵🇹 O raio de desenfoque para as sombras. (padrão 12)
                          # 🇪🇸 El radio de desenfoque para las sombras. (por defecto 12)

shadow-offset-x = -15;		# 🇬🇧 The left offset for shadows. (default -15)
                          # 🇵🇹 O deslocamento esquerdo para as sombras. (padrão -15)
                          # 🇪🇸 El desplazamiento a la izquierda para las sombras. (por defecto -15)

shadow-offset-y = -15;		# 🇬🇧 The top offset for shadows. (default -15)
                          # 🇵🇹 O deslocamento superior para as sombras. (padrão -15)
                          # 🇪🇸 El desplazamiento superior para las sombras. (por defecto -15)
shadow-opacity = 0.5;
menu-opacity = 1;
shadow-exclude = 
[
  "class_g = 'slop'",
  "n:e:Notification",
  # "class_g ?= 'xfce4-notifyd'",
  # "class_g ?= 'xfce4-power-manager'"
];

opacity-rule = 
[
	"50:class_g = 'Bspwm' && class_i = 'presel_feedback'",
	"99:class_g = 'slop'"
];

# 🇬🇧 The shadow exclude options are helpful if you have shadows enabled. Due to the way Compton draws its shadows, certain applications will have visual glitches (most applications are fine, only apps that do weird things with ‘xshapes’ or ‘argb’ are affected). 
# 🇵🇹 As opções de exclusão de sombra são úteis se você tiver sombras ativadas. Devido à maneira como Compton desenha suas sombras, certos aplicativos terão falhas visuais (a maioria dos aplicativos é boa, apenas aplicativos que fazem coisas estranhas com «xshapes» ou «argb» são afetadas). 
# 🇪🇸 Las opciones de exclusión de sombras son útiles si usted tiene sombras habilitadas. Debido a la forma en que Compton dibuja sus sombras, ciertas aplicaciones tendrán fallas visuales (la mayoría de las aplicaciones están bien, sólo las aplicaciones que hacen cosas extrañas con «xspes» o «argb» serán afectadas).

# 🇬🇧 This list includes all the affected apps I found in my testing. The `! name~=''` part excludes shadows on any ‘unknown’ windows, this prevents a visual glitch with the XFWM alt tab switcher.
# 🇵🇹 Esta lista inclui todos os aplicativos afetados que encontrei no meu teste. A parte `! name~=''` exclui sombras em qualquer janela «desconhecida», isto previne uma falha visual com o alternador de guia XFWM.
# 🇪🇸 Esta lista incluye todos los aplicativos afectados que encontré en mi teste. La parte `! name~=''` excluye sombras en cualquier ventana «desconhecida», esto previene un fallo visual con el selector de pestaña XFWM.

# 🇬🇧 Fading
# 🇵🇹 Desbotação
# 🇪🇸 Desvanecimiento
fading = true;                # 🇬🇧 To fade windows during opacity changes.
                              # 🇵🇹 Ativar o desbotamento de janelas durante as mudanças de opacidade.
                              # 🇪🇸 Activar el desvanecimiento de ventanas durante los cambios de opacidad.

fade-delta = 4;               # 🇬🇧 The time between steps in a fade in milliseconds. (default 10).
                              # 🇵🇹 O tempo entre os passos de um desbotamento em milissegundos. (padrão 10).
                              # 🇪🇸 El tiempo entre los pasos de un desvanecimiento en milisegundos. (por defecto 10).

fade-in-step = 0.03;          # 🇬🇧 Opacity change between steps while fading in. (default 0.028).
                              # 🇵🇹 Mudança de opacidade entre pasos durante o desbotamento interno. (padrão 0.028).
                              # 🇪🇸 Cambio de opacidad entre pasos durante el desvanecimiento interno. (por defecto 0.028).

fade-out-step = 0.03;         # 🇬🇧 Opacity change between steps while fading out. (default 0.03).
                              # 🇵🇹 Mudança de opacidade entre pasos durante o desbotamento externo. (padrão 0.03).
                              # 🇪🇸 Cambio de opacidad entre pasos durante el desvanecimiento externo. (por defecto 0.03).

no-fading-openclose = false;  # 🇬🇧 To fade windows in/out when opening or closing.
                              # 🇵🇹 Ativar o desbotamento de janelas durante as aberturas ou os fechamentos.
                              # 🇪🇸 Activar el desvanecimiento de ventanas durante las abreviaturas o los cierres.

# 🇬🇧 This prevents opacity from being ignored for some apps. For example, without this enabled, `xfce4-notifyd` is 100% opacity, no matter what.
# 🇵🇹 Isto previne a opacidade de ser ignorada para algumas aplicações. Por exemplo, sem ativar isto, o `xfce4-notifyd` é 100% opacidade, independentemente de qualquer coisa.
# 🇪🇸 Esto previene que la opacidad se ignore por algunos aplicativos. Por ejemplo, sin activar esto, `xfce4-notifyd` es 100% opacidad, independientemente de cualquier cosa.
detect-client-opacity = true; 

# 🇬🇧 Window type settings
# 🇵🇹 Configurações de tipo de janela
# 🇪🇸 Ajustes de tipo de ventana
wintypes:
{
  dropdown_menu = 
  { 
    shadow = false; 
  };
  menu = 
  { 
    shadow = false; 
  };
  popup_menu =  { 
    shadow = false; 
  };
  tooltip = 
  { 
    fade = true; 
    shadow = false; 
  };
};
