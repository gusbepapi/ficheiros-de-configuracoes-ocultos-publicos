 
[Desktop Entry]
Actions = copy-path
Encoding = UTF-8
MimeType = all/allfiles;inode/directory;
ServiceTypes = KonqPopupMenu/Plugin
Type = Service
X-KDE-Priority = TopLevel

[Desktop Action copy-path]
Exec = echo "%U" | tr -d '\n' | wl-copy 
Icon = klipper
MimeType = all/allfiles; inode/directory;
Name = Copy Path (Sway)